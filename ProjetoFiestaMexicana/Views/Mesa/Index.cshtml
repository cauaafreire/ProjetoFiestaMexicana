@model IEnumerable<ProjetoFiestaMexicana.Models.Mesas>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mesas";
}

<div class="page-container">

    <h2>Mesas</h2>

    @if (TempData["ok"] != null)
    {
        <div class="ok">@TempData["ok"]</div>
    }
    @if (TempData["erro"] != null)
    {
        <div class="erro">@TempData["erro"]</div>
    }

    <p><a asp-action="Criar" class="btn-novo">Nova Mesa</a></p>

    <div class="table-responsive">
        <table class="tbl">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Número</th>
                    <th>Capacidade</th>
                    <th>Status</th>
                    <th>Criado Em</th>
                    <th class="col-acoes">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td data-label="ID">@m.Id</td>
                        <td data-label="Número">Mesa @m.Numero</td>
                        <td data-label="Capacidade">@m.Capacidade pessoas</td>
                        <td data-label="Status">
                            <span class="status-badge @(m.Status == "Livre" ? "status-livre" : "status-ocupado")">
                                @m.Status
                            </span>
                        </td>
                        <td data-label="Criado Em">@m.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-label="Ações">
                            <div class="acoes">
                                <form asp-action="Editar" method="get">
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <button type="submit" class="btn btn-editar">Editar</button>
                                </form>
                                <form asp-action="Excluir" method="post" onsubmit="return confirm('Excluir esta mesa?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <button type="submit" class="btn btn-excluir">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>