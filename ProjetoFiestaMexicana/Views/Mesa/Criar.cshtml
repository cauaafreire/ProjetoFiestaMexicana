@model ProjetoFiestaMexicana.Models.Mesas
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Nova Mesa";
}

<div class="page-header">
    <h2>Nova Mesa</h2>
</div>

<style>
    .page-header h2 {
        text-align: center;
        color: #2d2d2d;
        margin-top: 30px;
        font-family: 'Segoe UI', sans-serif;
    }

    .card {
        background: #ffffff;
        max-width: 550px;
        margin: 20px auto 50px auto;
        padding: 35px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        font-family: 'Segoe UI', sans-serif;
    }

    .form-grid {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .field label {
            font-weight: 600;
            color: #2d2d2d;
            font-size: 14px;
        }

    .input {
        padding: 12px 15px;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 15px;
        background-color: #fff;
        width: 100%;
        box-sizing: border-box;
        transition: border-color 0.3s;
    }

        .input:focus {
            border-color: #ff5a5f;
            outline: none;
        }

    .form-actions {
        margin-top: 35px;
        display: flex;
        gap: 15px;
        justify-content: center;
    }

    .btn {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
        text-align: center;
        min-width: 150px;
        font-size: 15px;
        transition: all 0.2s;
        border: none;
    }

        .btn-light, .btn:not(.btn-primary) {
            background-color: #ff5a5f !important;
            color: #ffffff !important;
        }

    .btn-primary {
        background-color: #2d2d2d !important;
        color: #ffffff !important;
    }

    .btn:hover {
        opacity: 0.85;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .validation {
        background-color: #ffeaea;
        color: #ef4444;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        border: 1px solid #ef4444;
        font-size: 14px;
    }
</style>


<div class="card">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Criar" method="post">
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="field">
                <label>Número da Mesa</label>
                <input asp-for="Numero" type="number" class="input" required />
            </div>

            <div class="field">
                <label>Capacidade (Pessoas)</label>
                <input asp-for="Capacidade" type="number" min="1" class="input" required />
            </div>

            <div class="field">
                <label>Status Inicial</label>
                <select asp-for="Status" asp-items="ViewBag.StatusMesa" class="input" required></select>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-light">Salvar</button>
            <a asp-action="Index" class="btn btn-primary">Cancelar</a>
        </div>
    </form>
</div>
