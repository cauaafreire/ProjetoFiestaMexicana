@using ProjetoFiestaMexicana.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cardápio Fiesta Mexicana";

    // Recupera os grupos de pratos enviados pelo Controller
    var grupos = ViewBag.Grupos as Dictionary<string, List<Pratos>>;
}

<div class="fiesta-hero">
    <img src="~/logos/bannerf.png" alt="Banner Fiesta Mexicana" class="hero-banner-img" />
</div>

<div class="fiesta-page-container">

    <!-- 2. NAVEGAÇÃO DE CATEGORIAS (Lado a lado ) -->
    <div class="category-nav-wrapper">
        <div class="category-nav">
            @if (grupos != null)
            {
                foreach (var g in grupos.Keys)
                {
                    <a href="#cat-@g.Replace(" ", "-")" class="cat-btn">@g</a>
                }
            }
        </div>
    </div>

    @if (TempData["ok"] != null)
    {
        <div class="fiesta-toast">🌮 @TempData["ok"]</div>
    }

    <!-- 3. CONTEÚDO DO MENU (Agrupado por Categoria) -->
    <div class="menu-sections">
        @if (grupos != null && grupos.Any())
        {
            foreach (var g in grupos)
            {
                <section id="cat-@g.Key.Replace(" ", "-")" class="menu-category-section">
                    <h2 class="category-title">@g.Key</h2>

                    <div class="products-grid">
                        @foreach (var p in g.Value)
                        {
                            <div class="product-card">
                                <div class="product-img-box">
                                    @if (!string.IsNullOrWhiteSpace(p.CapaArquivo))
                                    {
                                        <img src="~/@p.CapaArquivo" alt="@p.Nome" />
                                    }
                                    else
                                    {
                                        <div class="no-img">🌶️</div>
                                    }
                                    <span class="product-price">@p.Preco.ToString("C")</span>
                                </div>

                                <div class="product-details">
                                    <h3 class="product-name">@p.Nome</h3>
                                    <p class="product-desc">@p.Descricao</p>

                                    <div class="product-info-small">
                                        @if (!string.IsNullOrEmpty(p.NivelPicancia))
                                        {
                                            <span>🔥 @p.NivelPicancia</span>
                                        }
                                        @if (p.TempoPreparo.HasValue)
                                        {
                                            <span>⏱️ @p.TempoPreparo min</span>
                                        }
                                    </div>

                                    <a href="/Pedido/Detalhes/@(p.Id)" class="add-to-cart-btn" style="display:block; text-align:center; text-decoration:none; padding:14px; background:#2d2d2d; color:#fff; border-radius:15px; font-weight:800; font-size:0.88rem; text-transform:uppercase; letter-spacing:1px; transition:background 0.3s;" onmouseover="this.style.background='#FF5757'" onmouseout="this.style.background='#2d2d2d'">
                                        VER DETALHES
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        }
        else
        {
            <div class="empty-state">
                <h3>Ops! O cardápio está sendo preparado.</h3>
                <p>Volte em instantes para conferir nossas delícias.</p>
            </div>
        }
    </div>
</div>

<style>
    .fiesta-page-container { 
        min-height: 100vh;
        padding-bottom: 80px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .fiesta-hero {
        width: 100%;
        background: #FF5757;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 0;
    }

        .fiesta-hero img {
            max-width: 600px;
            width: 80%;
            height: auto;
            display: block;
            object-fit: contain;
        }

    .hero-banner-img {
        width: 100%;
        height: 100%;

    }

    .hero-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: white;
        width: 100%;
    }

    .hero-title {
        font-size: 4rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 5px;
        margin-bottom: 0;
    }

    .fiesta-divider {
        width: 100px;
        height: 5px;
        background: #FF5757;
        margin: 10px auto;
        border-radius: 10px;
    }

    /* NAVEGAÇÃO DE CATEGORIAS */
    .category-nav-wrapper {
        background: white;
        padding: 20px 0;
        position: sticky;
        top: 0;
        z-index: 1000;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }

    .category-nav {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        gap: 15px;
        overflow-x: auto;
        padding: 0 20px;
        scrollbar-width: none; /* Esconde scroll no Firefox */
    }

        .category-nav::-webkit-scrollbar {
            display: none;
        }
    /* Esconde scroll no Chrome */

    .cat-btn {
        padding: 12px 25px;
        background: #f8f9fa;
        color: #2d2d2d;
        text-decoration: none !important;
        border-radius: 50px;
        font-weight: 700;
        white-space: nowrap;
        transition: all 0.3s;
        border: 2px solid #eee;
    }

        .cat-btn:hover {
            background: #FF5757;
            color: white;
            border-color: #FF5757;
        }

    /* SEÇÕES DE CATEGORIA */
    .menu-sections {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .category-title {
        color: white;
        font-size: 2.5rem;
        font-weight: 900;
        margin: 60px 0 30px;
        text-transform: uppercase;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        display: flex;
        align-items: center;
        gap: 15px;
    }

        .category-title::after {
            content: "";
            flex: 1;
            height: 2px;
            background: rgba(255,255,255,0.3);
        }

    /* GRID DE PRODUTOS */
    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
    }

    .product-card {
        background: white;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .product-card:hover {
            transform: translateY(-10px);
        }

    .product-img-box {
        height: 220px;
        position: relative;
        background: #f0f0f0;
    }

        .product-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .product-price {
        position: absolute;
        bottom: 15px;
        right: 15px;
        background: #FF5757;
        color: white;
        padding: 8px 18px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 1.1rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .product-details {
        padding: 25px;
        text-align: center;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .product-name {
        font-size: 1.4rem;
        font-weight: 800;
        color: #2d2d2d;
        margin-bottom: 10px;
    }

    .product-desc {
        color: #777;
        font-size: 0.95rem;
        line-height: 1.4;
        margin-bottom: 15px;
        flex-grow: 1;
    }

    .product-info-small {
        display: flex;
        justify-content: center;
        gap: 15px;
        font-size: 0.85rem;
        color: #999;
        margin-bottom: 15px;
    }

    .add-to-cart-btn {
        width: 100%;
        background: #2d2d2d;
        color: white;
        border: none;
        padding: 14px;
        border-radius: 15px;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.3s;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .add-to-cart-btn:hover {
            background: #FF5757;
            transform: scale(1.02);
        }

    .fiesta-toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        background: #2d2d2d;
        color: white;
        padding: 15px 40px;
        border-radius: 50px;
        z-index: 2000;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        animation: slideUp 0.5s ease;
    }

    @@keyframes slideUp {
        from {
            bottom: -100px;
        }

        to {
            bottom: 30px;
        }
    }

    .empty-state {
        text-align: center;
        color: white;
        padding: 100px 0;
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.5rem;
        }

        .fiesta-hero {
            height: 250px;
        }

        .category-title {
            font-size: 1.8rem;
        }
    }
</style>
