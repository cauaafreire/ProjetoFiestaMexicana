@using ProjetoFiestaMexicana.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cardápio";
    var grupos = ViewBag.Grupos as Dictionary<string, List<Pratos>>;
    var isLogged = Context.Session.GetInt32("UserId").HasValue;
}

<style>
    /* ── Reset local ── */
    .menu-page {
        font-family: 'Segoe UI', sans-serif;
        background: #fff;
    }

    /* ── Banner ── */
    .fiesta-hero {
        width: 100%;
        background: #FF5757;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px 0;
        /* Garante largura total mesmo com container logado */
        margin-left: calc(-20px);
        margin-right: calc(-20px);
        width: calc(100% + 40px);
    }

        .fiesta-hero img {
            max-width: 520px;
            width: 75%;
            height: auto;
            object-fit: contain;
            display: block;
        }

    /* ── Tabs de categoria ── */
    .cat-nav-wrap {
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        position: sticky;
        top: 0;
        z-index: 100;
        margin-left: calc(-20px);
        margin-right: calc(-20px);
    }

    .cat-nav {
        display: flex;
        overflow-x: auto;
        scrollbar-width: none;
        padding: 0 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

        .cat-nav::-webkit-scrollbar {
            display: none;
        }

    .cat-tab {
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 14px 22px;
        font-size: 0.88rem;
        font-weight: 700;
        color: #6b7280;
        cursor: pointer;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: all 0.2s;
    }

        .cat-tab:hover {
            color: #FF5757;
        }

        .cat-tab.ativa {
            color: #FF5757;
            border-bottom-color: #FF5757;
        }

    /* ── Seções ── */
    .menu-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 32px 0 80px;
    }

    .menu-secao {
        display: none;
    }

        .menu-secao.ativa {
            display: block;
        }

    .secao-titulo {
        font-size: 1.4rem;
        font-weight: 800;
        color: #111827;
        margin-bottom: 24px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .secao-titulo::after {
            content: "";
            flex: 1;
            height: 2px;
            background: #f3f4f6;
            border-radius: 2px;
        }

    /* ── Grid ── */
    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 24px;
        margin-bottom: 48px;
    }

    .product-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid #e5e7eb;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 28px rgba(0,0,0,0.12);
        }

    .product-img-box {
        width: 100%;
        height: 210px;
        background: #f3f4f6;
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
    }

        .product-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .no-img {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3.5rem;
    }

    .product-price {
        position: absolute;
        bottom: 12px;
        right: 12px;
        background: #FF5757;
        color: #fff;
        padding: 6px 14px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 1rem;
        box-shadow: 0 3px 10px rgba(0,0,0,0.2);
    }

    .product-details {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: 6px;
    }

    .product-name {
        font-size: 1.05rem;
        font-weight: 800;
        color: #111827;
        margin: 0;
    }

    .product-desc {
        font-size: 0.82rem;
        color: #6b7280;
        line-height: 1.5;
        margin: 0;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-info-small {
        display: flex;
        gap: 10px;
        font-size: 0.78rem;
        color: #9ca3af;
        flex-wrap: wrap;
    }

    .btn-detalhes {
        margin-top: 10px;
        width: 100%;
        background: #111827;
        color: #fff;
        border: none;
        padding: 13px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        transition: background 0.2s;
        text-decoration: none;
        display: block;
        text-align: center;
    }

        .btn-detalhes:hover {
            background: #FF5757;
            color: #fff;
        }

    /* ── Toast ── */
    .fiesta-toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        background: #111827;
        color: #fff;
        padding: 14px 36px;
        border-radius: 50px;
        z-index: 3000;
        box-shadow: 0 8px 24px rgba(0,0,0,0.25);
        font-weight: 600;
        animation: slideUp 0.4s ease;
        white-space: nowrap;
    }

    @@keyframes slideUp {
        from {
            bottom: -80px;
            opacity: 0;
        }

        to {
            bottom: 30px;
            opacity: 1;
        }
    }

    /* ── Empty state ── */
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #9ca3af;
    }

        .empty-state p {
            font-size: 1rem;
        }

    @@media (max-width: 640px) {
        .fiesta-hero {
            padding: 20px 0;
        }

            .fiesta-hero img {
                width: 85%;
            }

        .products-grid {
            grid-template-columns: 1fr;
        }

        .secao-titulo {
            font-size: 1.1rem;
        }
    }
</style>

<div class="menu-page">

    <!-- Banner -->
    <div class="fiesta-hero">
        <img src="~/logos/bannerf.png" alt="Fiesta Mexicana" />
    </div>

    <!-- Tabs -->
    @if (grupos != null && grupos.Any())
    {
        <div class="cat-nav-wrap">
            <nav class="cat-nav">
                @for (int i = 0; i < grupos.Keys.Count; i++)
                {
                    var cat = grupos.Keys.ElementAt(i);
                    var ativa = i == 0 ? "ativa" : "";
                    <button class="cat-tab @(ativa)"
                            onclick="mostrarCat('@(cat)', this)">
                        @cat
                    </button>
                }
            </nav>
        </div>
    }

    @if (TempData["ok"] != null)
    {
        <div class="fiesta-toast">🌮 @TempData["ok"]</div>
    }

    <!-- Seções -->
    <div class="menu-wrap">
        @if (grupos != null && grupos.Any())
        {
            for (int i = 0; i < grupos.Keys.Count; i++)
            {
                var cat = grupos.Keys.ElementAt(i);
                var lista = grupos[cat];
                var ativa = i == 0 ? "ativa" : "";

                <div class="menu-secao @(ativa)" id="secao-@(i)" data-cat="@(cat)">
                    <div class="secao-titulo">@(cat)</div>
                    <div class="products-grid">
                        @for (int j = 0; j < lista.Count; j++)
                        {
                            var p = lista[j];
                            <div class="product-card">
                                <div class="product-img-box">
                                    @if (!string.IsNullOrWhiteSpace(p.CapaArquivo))
                                    {
                                        <img src="~/@(p.CapaArquivo)" alt="@(p.Nome)" />
                                    }
                                    else
                                    {
                                        <div class="no-img">🌶️</div>
                                    }
                                    <span class="product-price">@(p.Preco.ToString("C"))</span>
                                </div>
                                <div class="product-details">
                                    <h3 class="product-name">@(p.Nome)</h3>
                                    @if (!string.IsNullOrWhiteSpace(p.Descricao))
                                    {
                                        <p class="product-desc">@(p.Descricao)</p>
                                    }
                                    <div class="product-info-small">
                                        @if (!string.IsNullOrEmpty(p.NivelPicancia) && p.NivelPicancia != "Sem Pimenta")
                                        {
                                            <span>🔥 @(p.NivelPicancia)</span>
                                        }
                                        @if (p.TempoPreparo.HasValue)
                                        {
                                            <span>⏱️ @(p.TempoPreparo) min</span>
                                        }
                                    </div>
                                    <a href="/Pedido/Detalhes/@(p.Id)" class="add-to-cart-btn" style="display:block; text-align:center; text-decoration:none; padding:14px; background:#2d2d2d; color:#fff; border-radius:15px; font-weight:800; font-size:0.88rem; text-transform:uppercase; letter-spacing:1px; transition:background 0.3s;" onmouseover="this.style.background='#FF5757'" onmouseout="this.style.background='#2d2d2d'">
                                        VER DETALHES
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <p>Cardápio sendo preparado. Volte em instantes! 🌮</p>
            </div>
        }
    </div>

</div>

<script>
    function mostrarCat(nome, btn) {
        document.querySelectorAll('.menu-secao').forEach(s => s.classList.remove('ativa'));
        document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('ativa'));
        document.querySelectorAll('.menu-secao').forEach(s => {
            if (s.dataset.cat === nome) s.classList.add('ativa');
        });
        if (btn) btn.classList.add('ativa');
    }
</script>