@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cardápio — Garçom";
    var grupos = ViewBag.Grupos as Dictionary<string, List<ProjetoFiestaMexicana.Models.Pratos>>;
    var mesas = ViewBag.Mesas as List<SelectListItem> ?? new List<SelectListItem>();
    var garcons = ViewBag.Garcons as List<SelectListItem> ?? new List<SelectListItem>();
}

<style>
    .garcom-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 0;
        min-height: calc(100vh - 63px);
        margin: -20px;
    }

    /* ── Cardápio ── */
    .cardapio-area {
        padding: 24px;
        overflow-y: auto;
        background: #f9fafb;
    }

    .cardapio-topo {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

        .cardapio-topo h1 {
            font-size: 1.4rem;
            font-weight: 800;
            color: #111827;
            margin: 0;
        }

    .busca-wrap {
        display: flex;
        gap: 8px;
        align-items: center;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 6px 12px;
        flex: 1;
        max-width: 300px;
    }

        .busca-wrap input {
            border: none;
            outline: none;
            font-size: 0.9rem;
            flex: 1;
            color: #111827;
        }

        .busca-wrap button {
            background: #FF5757;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 5px 12px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
        }

    /* Tabs */
    .cat-tabs {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .cat-tab {
        background: #fff;
        border: 2px solid #e5e7eb;
        color: #374151;
        border-radius: 50px;
        padding: 8px 18px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }

        .cat-tab:hover {
            border-color: #FF5757;
            color: #FF5757;
        }

        .cat-tab.ativa {
            background: #FF5757;
            border-color: #FF5757;
            color: #fff;
        }

    /* Seções */
    .cat-secao {
        display: none;
    }

        .cat-secao.ativa {
            display: block;
        }

    .cat-titulo {
        font-size: 0.88rem;
        font-weight: 800;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .cat-titulo::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e5e7eb;
        }

    /* Grid pratos */
    .pratos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 14px;
        margin-bottom: 32px;
    }

    .prato-card {
        background: #fff;
        border-radius: 14px;
        border: 2px solid #f3f4f6;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .prato-card:hover {
            border-color: #FF5757;
            box-shadow: 0 4px 16px rgba(255,87,87,0.12);
        }

    .prato-foto {
        width: 100%;
        height: 130px;
        background: #f3f4f6;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        flex-shrink: 0;
    }

        .prato-foto img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .prato-info {
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 3px;
        flex: 1;
    }

    .prato-nome {
        font-size: 0.88rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.3;
    }

    .prato-preco {
        font-size: 0.95rem;
        font-weight: 800;
        color: #FF5757;
    }

    .prato-desc {
        font-size: 0.73rem;
        color: #9ca3af;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-add-comanda {
        margin: 0 10px 10px;
        background: #111827;
        color: #fff;
        border: none;
        padding: 9px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        width: calc(100% - 20px);
        transition: background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

        .btn-add-comanda:hover {
            background: #FF5757;
        }

        .btn-add-comanda.adicionado {
            background: #059669;
        }

    /* ── COMANDA sidebar ── */
    .comanda-sidebar {
        background: #fff;
        border-left: 1px solid #e5e7eb;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 63px);
        position: sticky;
        top: 63px;
    }

    .comanda-header {
        padding: 18px 20px;
        background: #FF5757;
        color: #fff;
        flex-shrink: 0;
    }

        .comanda-header h2 {
            margin: 0 0 2px;
            font-size: 1.05rem;
            font-weight: 800;
        }

        .comanda-header p {
            margin: 0;
            font-size: 0.78rem;
            opacity: 0.85;
        }

    .comanda-count {
        background: #fff;
        color: #FF5757;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 0.7rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: 6px;
    }

    /* Selects mesa/garçom */
    .comanda-config {
        padding: 12px 14px;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex-shrink: 0;
    }

    .comanda-select {
        width: 100%;
        padding: 9px 10px;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #111827;
        background: #fff;
        outline: none;
        cursor: pointer;
        appearance: auto;
    }

        .comanda-select:focus {
            border-color: #FF5757;
        }

        .comanda-select.erro {
            border-color: #ef4444;
            background: #fef2f2;
        }

    /* Itens */
    .comanda-itens {
        flex: 1;
        overflow-y: auto;
        padding: 10px 14px;
    }

        .comanda-itens::-webkit-scrollbar {
            width: 3px;
        }

        .comanda-itens::-webkit-scrollbar-thumb {
            background: #e5e7eb;
            border-radius: 3px;
        }

    .comanda-vazia {
        text-align: center;
        padding: 30px 20px;
        color: #9ca3af;
    }

        .comanda-vazia .icon {
            font-size: 2.2rem;
            margin-bottom: 8px;
        }

        .comanda-vazia p {
            font-size: 0.82rem;
            margin: 0;
        }

    .comanda-item {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 10px 0;
        border-bottom: 1px solid #f3f4f6;
    }

        .comanda-item:last-child {
            border-bottom: none;
        }

    .ci-foto {
        width: 40px;
        height: 40px;
        border-radius: 7px;
        background: #f3f4f6;
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

        .ci-foto img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .ci-meio {
        flex: 1;
        min-width: 0;
    }

    .ci-nome {
        font-size: 0.82rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.2;
    }

    .ci-sub {
        font-size: 0.75rem;
        color: #6b7280;
    }

    .ci-obs {
        width: 100%;
        margin-top: 5px;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 4px 7px;
        font-size: 0.73rem;
        color: #374151;
        outline: none;
        resize: none;
        font-family: inherit;
    }

        .ci-obs:focus {
            border-color: #FF5757;
        }

    .ci-ctrl {
        display: flex;
        align-items: center;
        gap: 5px;
        flex-shrink: 0;
    }

    .ci-btn {
        width: 24px;
        height: 24px;
        border-radius: 5px;
        border: 1px solid #e5e7eb;
        background: #f9fafb;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #374151;
        padding: 0;
        line-height: 1;
        transition: all 0.15s;
    }

        .ci-btn:hover {
            background: #FF5757;
            color: #fff;
            border-color: #FF5757;
        }

    .ci-qtd {
        font-size: 0.85rem;
        font-weight: 800;
        color: #111827;
        min-width: 16px;
        text-align: center;
    }

    .ci-rm {
        background: none;
        border: none;
        color: #d1d5db;
        cursor: pointer;
        font-size: 0.95rem;
        padding: 0;
        transition: color 0.15s;
        margin-left: 2px;
    }

        .ci-rm:hover {
            color: #ef4444;
        }

    /* Footer comanda */
    .comanda-footer {
        padding: 14px;
        border-top: 1px solid #f3f4f6;
        background: #fafafa;
        flex-shrink: 0;
    }

    .obs-geral {
        width: 100%;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 0.82rem;
        color: #374151;
        resize: none;
        outline: none;
        margin-bottom: 10px;
        font-family: inherit;
    }

        .obs-geral:focus {
            border-color: #FF5757;
        }

    .comanda-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .ct-label {
        font-size: 0.82rem;
        color: #6b7280;
        font-weight: 600;
    }

    .ct-valor {
        font-size: 1.3rem;
        font-weight: 800;
        color: #111827;
    }

    .btn-enviar {
        width: 100%;
        background: #FF5757;
        color: #fff;
        border: none;
        padding: 13px;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 800;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: background 0.2s;
    }

        .btn-enviar:hover {
            background: #e04444;
        }

        .btn-enviar:disabled {
            background: #d1d5db;
            cursor: default;
        }

    .btn-limpar {
        width: 100%;
        background: none;
        border: 1px solid #e5e7eb;
        color: #6b7280;
        padding: 7px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 6px;
        transition: all 0.15s;
    }

        .btn-limpar:hover {
            border-color: #ef4444;
            color: #ef4444;
        }

    /* Toast */
    .toast-msg {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        padding: 12px 28px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.88rem;
        z-index: 9999;
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
        animation: fadeUp 0.3s ease;
        white-space: nowrap;
    }

    .toast-ok {
        background: #059669;
        color: #fff;
    }

    .toast-erro {
        background: #dc2626;
        color: #fff;
    }

    @@keyframes fadeUp {
        from {
            bottom: -60px;
            opacity: 0;
        }

        to {
            bottom: 24px;
            opacity: 1;
        }
    }

    .modal-bg.aberto {
        display: flex !important;
    }

    @@keyframes popIn {
        from {
            transform: scale(0.85);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@media (max-width: 900px) {
        .garcom-layout {
            grid-template-columns: 1fr;
        }

        .comanda-sidebar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 50vh;
            top: auto;
            border-left: none;
            border-top: 3px solid #FF5757;
            z-index: 500;
        }
    }
</style>

<!-- Modal de confirmação de envio -->
<div class="modal-bg" id="modalConfirm" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:2000; align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:20px; padding:36px 32px; max-width:380px; width:90%; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,0.25); animation:popIn 0.3s ease;">
        <img src="~/logos/icon/check.png" alt="OK" style="width:72px; height:72px; margin:0 auto 16px; display:block;" />
        <div style="font-size:1.2rem; font-weight:800; color:#111827; margin-bottom:6px;">Enviar para a Cozinha?</div>
        <div style="font-size:0.85rem; color:#6b7280; margin-bottom:20px;">Confirme os dados da comanda</div>
        <div style="background:#f9fafb; border-radius:10px; padding:14px 16px; margin-bottom:20px; text-align:left;">
            <div style="display:flex; justify-content:space-between; font-size:0.85rem; padding:4px 0; color:#374151;">
                <span>Mesa</span><strong id="conf-mesa"></strong>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:0.85rem; padding:4px 0; color:#374151;">
                <span>Garçom</span><span id="conf-garcom"></span>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:1rem; font-weight:800; padding:8px 0 0; border-top:1px solid #e5e7eb; margin-top:6px; color:#111827;">
                <span>Total</span><span id="conf-total"></span>
            </div>
        </div>
        <button onclick="confirmarEnvio()" style="width:100%; background:#FF5757; color:#fff; border:none; padding:14px; border-radius:10px; font-size:1rem; font-weight:800; cursor:pointer; margin-bottom:8px;">
            🚀 Confirmar e Enviar
        </button>
        <button onclick="fecharModalConfirm()" style="width:100%; background:none; border:1px solid #e5e7eb; color:#6b7280; padding:10px; border-radius:10px; font-size:0.88rem; cursor:pointer;">
            Cancelar
        </button>
    </div>
</div>


<div class="garcom-layout">

    <!-- ── Cardápio ── -->
    <div class="cardapio-area">
        <div class="cardapio-topo">
            <h1>🍽 Cardápio</h1>
            <form method="get" asp-action="Cardapio" class="busca-wrap">
                <input name="q" value="@ViewBag.q" placeholder="Buscar prato..." />
                <button type="submit">🔍</button>
            </form>
        </div>

        @if (grupos != null && grupos.Any())
        {
            <div class="cat-tabs">
                @for (int i = 0; i < grupos.Keys.Count; i++)
                {
                    var cat = grupos.Keys.ElementAt(i);
                    var ativa = i == 0 ? "ativa" : "";
                    <button class="cat-tab @(ativa)" onclick="mostrarCat('@(cat)', this)">
                        @cat
                    </button>
                }
            </div>

            @for (int i = 0; i < grupos.Keys.Count; i++)
            {
                var cat = grupos.Keys.ElementAt(i);
                var lista = grupos[cat];
                var ativa = i == 0 ? "ativa" : "";

                <div class="cat-secao @(ativa)" id="cat-@(i)" data-cat="@(cat)">
                    <div class="cat-titulo">@cat</div>
                    <div class="pratos-grid">
                        @for (int j = 0; j < lista.Count; j++)
                        {
                            var p = lista[j];
                            <div class="prato-card">
                                <div class="prato-foto">
                                    @if (!string.IsNullOrWhiteSpace(p.CapaArquivo))
                                    {
                                        <img src="~/@(p.CapaArquivo)" alt="@(p.Nome)" />
                                    }
                                    else
                                    {

                                        <span>🌶️</span>
                                    }
                                </div>
                                <div class="prato-info">
                                    <div class="prato-nome">@(p.Nome)</div>
                                    <div class="prato-preco">@(p.Preco.ToString("C"))</div>
                                    @if (!string.IsNullOrEmpty(p.Descricao))
                                    {
                                        <div class="prato-desc">@(p.Descricao)</div>
                                    }
                                </div>
                                <button class="btn-add-comanda" id="btn-@(p.Id)"
                                        onclick="adicionarItem(@(p.Id), '@(p.Nome.Replace("'", "\\'")){', @(p.Preco.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)), '@(p.CapaArquivo ?? "")')">
                                    ➕ Adicionar
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div style="text-align:center;padding:60px;color:#9ca3af;">Nenhum prato disponível.</div>
        }
    </div>

    <!-- ── Comanda ── -->
    <div class="comanda-sidebar">

        <div class="comanda-header">
            <h2>🧾 Comanda <span class="comanda-count" id="countTotal">0</span></h2>
            <p>Selecione mesa, garçom e adicione os pratos</p>
        </div>

        <!-- Seleção de mesa e garçom -->
        <div class="comanda-config">
            <select class="comanda-select" id="selMesa">
                <option value="">🪑 Selecione a Mesa</option>
                @foreach (var m in mesas)
                {
                    <option value="@m.Value">@m.Text</option>
                }
            </select>
            <select class="comanda-select" id="selGarcom">
                <option value="">🤵 Selecione o Garçom</option>
                @foreach (var g in garcons)
                {
                    <option value="@g.Value">@g.Text</option>
                }
            </select>
        </div>

        <!-- Lista de itens -->
        <div class="comanda-itens" id="listaItens">
            <div class="comanda-vazia" id="vazia">
                <div class="icon">🛒</div>
                <p>Nenhum item.<br />Clique nos pratos ao lado.</p>
            </div>
        </div>

        <!-- Footer -->
        <div class="comanda-footer">
            <textarea class="obs-geral" id="obsGeral" rows="2"
                      placeholder="Observação geral (sem coentro, etc.)..."></textarea>
            <div class="comanda-total">
                <span class="ct-label">Total</span>
                <span class="ct-valor" id="totalValor">R$ 0,00</span>
            </div>
            <button class="btn-enviar" id="btnEnviar" disabled onclick="enviarComanda()">
                ENVIAR PARA COZINHA
            </button>
            <button class="btn-limpar" onclick="limparComanda()">🗑 Limpar comanda</button>
        </div>
    </div>

</div>

<!-- Form oculto para envio -->
<form id="formFinalizar" asp-action="Finalizar" method="post" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Mesa" id="fMesa" />
    <input type="hidden" name="Garcom" id="fGarcom" />
    <input type="hidden" name="Observacao" id="fObs" />
</form>

@section Scripts {
    <script>
        let comanda = {};

        function mostrarCat(nome, btn) {
            document.querySelectorAll('.cat-secao').forEach(s => s.classList.remove('ativa'));
            document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('ativa'));
            document.querySelectorAll('.cat-secao').forEach(s => {
                if (s.dataset.cat === nome) s.classList.add('ativa');
            });
            if (btn) btn.classList.add('ativa');
        }

        function adicionarItem(id, nome, preco, foto) {
            if (comanda[id]) {
                comanda[id].qtd++;
            } else {
                comanda[id] = { nome, preco: parseFloat(preco), foto, qtd: 1, obs: '' };
            }
            renderComanda();
            // Feedback visual — botão sempre volta ao estado normal
            const btn = document.getElementById('btn-' + id);
            if (btn) {
                btn.textContent = '✔ Adicionado!';
                btn.classList.add('adicionado');
                setTimeout(() => {
                    btn.textContent = '➕ Adicionar';
                    btn.classList.remove('adicionado');
                }, 900);
            }
        }

        function alterarQtd(id, delta) {
            if (!comanda[id]) return;
            comanda[id].qtd += delta;
            if (comanda[id].qtd <= 0) delete comanda[id];
            renderComanda();
        }

        function removerItem(id) {
            delete comanda[id];
            renderComanda();
            // IMPORTANTE: restaura o botão do prato na grid
            const btn = document.getElementById('btn-' + id);
            if (btn) {
                btn.textContent = '➕ Adicionar';
                btn.classList.remove('adicionado');
                btn.disabled = false;
            }
        }

        function atualizarObs(id, val) {
            if (comanda[id]) comanda[id].obs = val;
        }

        function renderComanda() {
            const lista   = document.getElementById('listaItens');
            const vazia   = document.getElementById('vazia');
            const count   = document.getElementById('countTotal');
            const totalEl = document.getElementById('totalValor');
            const btnEnv  = document.getElementById('btnEnviar');
            const ids     = Object.keys(comanda);

            count.textContent = ids.reduce((s, k) => s + comanda[k].qtd, 0);

            if (ids.length === 0) {
                lista.innerHTML = '';
                lista.appendChild(vazia);
                vazia.style.display = 'block';
                totalEl.textContent = 'R$ 0,00';
                btnEnv.disabled = true;
                return;
            }

            vazia.style.display = 'none';
            btnEnv.disabled = false;

            let total = 0;
            let html  = '';

            ids.forEach(id => {
                const it  = comanda[id];
                const sub = it.preco * it.qtd;
                total    += sub;
                const fotoHtml = it.foto
                    ? `<img src="/${it.foto}" alt="${it.nome}" />`
                    : '🌶️';

                html += `
                <div class="comanda-item" id="ci-${id}">
                    <div class="ci-foto">${fotoHtml}</div>
                    <div class="ci-meio">
                        <div class="ci-nome">${it.nome}</div>
                        <div class="ci-sub">${it.qtd}x · R$ ${sub.toFixed(2).replace('.',',')}</div>
                        <input class="ci-obs" placeholder="Obs. deste item..."
                               value="${it.obs}"
                               oninput="atualizarObs(${id}, this.value)" />
                    </div>
                    <div class="ci-ctrl">
                        <button class="ci-btn" onclick="alterarQtd(${id}, -1)">−</button>
                        <span class="ci-qtd">${it.qtd}</span>
                        <button class="ci-btn" onclick="alterarQtd(${id}, 1)">+</button>
                        <button class="ci-rm" onclick="removerItem(${id})" title="Remover">🗑</button>
                    </div>
                </div>`;
            });

            lista.innerHTML = html;
            totalEl.textContent = 'R$ ' + total.toFixed(2).replace('.', ',');
        }

        function limparComanda() {
            if (Object.keys(comanda).length === 0) return;
            if (!confirm('Limpar toda a comanda?')) return;
            // Restaura todos os botões
            Object.keys(comanda).forEach(id => {
                const btn = document.getElementById('btn-' + id);
                if (btn) { btn.textContent = '➕ Adicionar'; btn.classList.remove('adicionado'); btn.disabled = false; }
            });
            comanda = {};
            renderComanda();
        }

        async function enviarComanda() {
            const mesa   = document.getElementById('selMesa').value;
            const garcom = document.getElementById('selGarcom').value;
            const obs    = document.getElementById('obsGeral').value;

            const sMesa   = document.getElementById('selMesa');
            const sGarcom = document.getElementById('selGarcom');
            let ok = true;

            if (!mesa)   { sMesa.classList.add('erro');   ok = false; } else sMesa.classList.remove('erro');
            if (!garcom) { sGarcom.classList.add('erro');  ok = false; } else sGarcom.classList.remove('erro');
            if (!ok) { mostrarToast('Selecione mesa e garçom!', 'erro'); return; }
            if (Object.keys(comanda).length === 0) { mostrarToast('Comanda vazia!', 'erro'); return; }

            const btn = document.getElementById('btnEnviar');
            btn.disabled    = true;
            btn.textContent = 'Enviando...';

            let obsCompleta = obs;
            Object.values(comanda).forEach(it => {
                if (it.obs) obsCompleta += (obsCompleta ? ' | ' : '') + it.nome + ': ' + it.obs;
            });

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            await fetch('/Pedido/LimparCarrinho', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `__RequestVerificationToken=${encodeURIComponent(token)}`
            });

            for (const id of Object.keys(comanda)) {
                for (let q = 0; q < comanda[id].qtd; q++) {
                    await fetch('/Pedido/AdicionarAoPedidoSilencioso', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
                    });
                }
            }

            document.getElementById('fMesa').value   = mesa;
            document.getElementById('fGarcom').value = garcom;
            document.getElementById('fObs').value    = obsCompleta;
            mostrarModalConfirmacao();
        }

        function mostrarToast(msg, tipo) {
            document.querySelectorAll('.toast-msg').forEach(t => t.remove());
            const t = document.createElement('div');
            t.className   = `toast-msg toast-${tipo}`;
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => t.remove(), 3000);
        }

        function mostrarModalConfirmacao() {
            const mesa   = document.getElementById('selMesa').options[document.getElementById('selMesa').selectedIndex].text;
            const garcom = document.getElementById('selGarcom').options[document.getElementById('selGarcom').selectedIndex].text;
            const total  = document.getElementById('totalValor').textContent;

            document.getElementById('conf-mesa').textContent   = mesa;
            document.getElementById('conf-garcom').textContent = garcom;
            document.getElementById('conf-total').textContent  = total;
            document.getElementById('modalConfirm').classList.add('aberto');
            document.body.style.overflow = 'hidden';
        }

        function fecharModalConfirm() {
            document.getElementById('modalConfirm').classList.remove('aberto');
            document.body.style.overflow = '';
            const btn = document.getElementById('btnEnviar');
            btn.disabled    = false;
            btn.textContent = 'ENVIAR PARA COZINHA';
        }

        function confirmarEnvio() {
            document.getElementById('formFinalizar').submit();
        }
    </script>
}