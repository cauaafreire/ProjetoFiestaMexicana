@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cardápio — Garçom";
    var grupos = ViewBag.Grupos as Dictionary<string, List<ProjetoFiestaMexicana.Models.Pratos>>;
}

<style>
    .cardapio-area {
        padding: 24px;
        overflow-y: auto;
        background: #f9fafb;
        min-height: calc(100vh - 63px);
    }

    .cardapio-topo {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

        .cardapio-topo h1 {
            font-size: 1.4rem;
            font-weight: 800;
            color: #111827;
            margin: 0;
        }

    .topo-acoes {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .busca-wrap {
        display: flex;
        gap: 8px;
        align-items: center;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 6px 12px;
        min-width: 220px;
    }

        .busca-wrap input {
            border: none;
            outline: none;
            font-size: 0.9rem;
            flex: 1;
            color: #111827;
            background: transparent;
        }

        .busca-wrap .busca-icon {
            color: #9ca3af;
            font-size: 0.95rem;
        }

    .btn-ir-pedido {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #FF5757;
        color: #fff;
        text-decoration: none;
        border-radius: 10px;
        padding: 8px 16px;
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
        transition: background 0.2s;
        position: relative;
    }

        .btn-ir-pedido:hover {
            background: #e04444;
            color: #fff;
        }

    .cart-badge {
        position: absolute;
        top: -7px;
        right: -7px;
        background: #111827;
        color: #fff;
        font-size: 0.65rem;
        font-weight: 800;
        border-radius: 50%;
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        display: none;
    }

        .cart-badge.visivel {
            display: flex;
        }

    /* Tabs */
    .cat-tabs {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .cat-tab {
        background: #fff;
        border: 2px solid #e5e7eb;
        color: #374151;
        border-radius: 50px;
        padding: 8px 18px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }

        .cat-tab:hover {
            border-color: #FF5757;
            color: #FF5757;
        }

        .cat-tab.ativa {
            background: #FF5757;
            border-color: #FF5757;
            color: #fff;
        }

    /* Seções */
    .cat-secao {
        display: none;
    }

        .cat-secao.ativa {
            display: block;
        }

    .cat-titulo {
        font-size: 0.88rem;
        font-weight: 800;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .cat-titulo::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e5e7eb;
        }

    /* Grid pratos */
    .pratos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 14px;
        margin-bottom: 32px;
    }

    .prato-card {
        background: #fff;
        border-radius: 14px;
        border: 2px solid #f3f4f6;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .prato-card:hover {
            border-color: #FF5757;
            box-shadow: 0 4px 16px rgba(255,87,87,0.12);
        }

        /* esconde card quando não bate com busca */
        .prato-card.oculto {
            display: none;
        }

    .prato-foto {
        width: 100%;
        height: 130px;
        background: #f3f4f6;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        flex-shrink: 0;
    }

        .prato-foto img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .prato-info {
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 3px;
        flex: 1;
    }

    .prato-nome {
        font-size: 0.88rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.3;
    }

    .prato-preco {
        font-size: 0.95rem;
        font-weight: 800;
        color: #FF5757;
    }

    .prato-desc {
        font-size: 0.73rem;
        color: #9ca3af;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-add-comanda {
        margin: 0 10px 10px;
        background: #111827;
        color: #fff;
        border: none;
        padding: 9px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        width: calc(100% - 20px);
        transition: background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

        .btn-add-comanda:hover {
            background: #FF5757;
        }

        .btn-add-comanda.adicionado {
            background: #059669;
        }

    /* Mensagem sem resultados */
    .sem-resultado {
        display: none;
        text-align: center;
        padding: 40px;
        color: #9ca3af;
        font-size: 1rem;
        grid-column: 1/-1;
    }
</style>

<div class="cardapio-area">
    <div class="cardapio-topo">
        <h1>🍽 Cardápio</h1>

        <div class="topo-acoes">
            <!-- Busca em tempo real -->
            <div class="busca-wrap">
                <span class="busca-icon">🔍</span>
                <input type="text" id="campoBusca" placeholder="Buscar prato..." oninput="filtrarPratos(this.value)" />
            </div>

            <!-- Botão ir ao carrinho -->
            <a asp-controller="Pedido" asp-action="Pedido" class="btn-ir-pedido">
                🛒 Ver Pedido
                <span class="cart-badge" id="cartBadge">0</span>
            </a>
        </div>
    </div>

    @if (grupos != null && grupos.Any())
    {
        <div class="cat-tabs" id="catTabs">
            @for (int i = 0; i < grupos.Keys.Count; i++)
            {
                var cat = grupos.Keys.ElementAt(i);
                var ativa = i == 0 ? "ativa" : "";
                <button class="cat-tab @(ativa)" onclick="mostrarCat('@(cat)', this)">
                    @cat
                </button>
            }
        </div>

        @for (int i = 0; i < grupos.Keys.Count; i++)
        {
            var cat = grupos.Keys.ElementAt(i);
            var lista = grupos[cat];
            var ativa = i == 0 ? "ativa" : "";

            <div class="cat-secao @(ativa)" id="cat-@(i)" data-cat="@(cat)">
                <div class="cat-titulo">@cat</div>
                <div class="pratos-grid">
                    @for (int j = 0; j < lista.Count; j++)
                    {
                        var p = lista[j];
                        <div class="prato-card" data-nome="@(p.Nome.ToLower())" data-desc="@((p.Descricao ?? "").ToLower())">
                            <div class="prato-foto">
                                @if (!string.IsNullOrWhiteSpace(p.CapaArquivo))
                                {
                                    <img src="~/@(p.CapaArquivo)" alt="@(p.Nome)" />
                                }
                                else
                                {
                                    <span>🌶️</span>
                                }
                            </div>
                            <div class="prato-info">
                                <div class="prato-nome">@(p.Nome)</div>
                                <div class="prato-preco">@(p.Preco.ToString("C"))</div>
                                @if (!string.IsNullOrEmpty(p.Descricao))
                                {
                                    <div class="prato-desc">@(p.Descricao)</div>
                                }
                            </div>
                            <button class="btn-add-comanda" id="btn-@(p.Id)"
                                    onclick="adicionarItem(@(p.Id), this)">
                                ➕ Adicionar
                            </button>
                        </div>
                    }
                    <div class="sem-resultado" id="sem-@(i)">Nenhum prato encontrado 🌵</div>
                </div>
            </div>
        }
    }
    else
    {
        <div style="text-align:center;padding:60px;color:#9ca3af;">Nenhum prato disponível.</div>
    }
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        let totalCarrinho = 0;

        // Carrega contagem do carrinho ao entrar na página
        async function carregarContadorCarrinho() {
            try {
                const resp = await fetch('/Pedido/GetCartJson');
                if (resp.ok) {
                    const data = await resp.json();
                    const total = Object.values(data).reduce((s, it) => s + it.qtd, 0);
                    atualizarBadge(total);
                }
            } catch {}
        }

        function atualizarBadge(qtd) {
            totalCarrinho = qtd;
            const badge = document.getElementById('cartBadge');
            badge.textContent = qtd;
            badge.classList.toggle('visivel', qtd > 0);
        }

        function mostrarCat(nome, btn) {
            // Só troca aba se não estiver filtrando
            if (document.getElementById('campoBusca').value.trim()) return;
            document.querySelectorAll('.cat-secao').forEach(s => s.classList.remove('ativa'));
            document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('ativa'));
            document.querySelectorAll('.cat-secao').forEach(s => {
                if (s.dataset.cat === nome) s.classList.add('ativa');
            });
            if (btn) btn.classList.add('ativa');
        }

        function filtrarPratos(q) {
            const termo = q.trim().toLowerCase();
            const tabs  = document.getElementById('catTabs');

            if (!termo) {
                // Sem filtro: volta ao modo normal com abas
                tabs.style.display = '';
                document.querySelectorAll('.cat-secao').forEach((s, i) => {
                    s.classList.toggle('ativa', i === 0);
                    s.querySelectorAll('.prato-card').forEach(c => c.classList.remove('oculto'));
                    document.getElementById('sem-' + i)?.style.setProperty('display', 'none');
                });
                // Reativa a primeira aba
                const primeiraTab = document.querySelector('.cat-tab');
                document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('ativa'));
                if (primeiraTab) primeiraTab.classList.add('ativa');
                return;
            }

            // Com filtro: mostra todas as seções, esconde abas visuais
            tabs.style.display = 'none';
            document.querySelectorAll('.cat-secao').forEach((s, i) => {
                s.classList.add('ativa');
                const cards  = s.querySelectorAll('.prato-card');
                let visiveis = 0;

                cards.forEach(card => {
                    const nome = card.dataset.nome || '';
                    const desc = card.dataset.desc || '';
                    const bate = nome.includes(termo) || desc.includes(termo);
                    card.classList.toggle('oculto', !bate);
                    if (bate) visiveis++;
                });

                const semMsg = document.getElementById('sem-' + i);
                if (semMsg) semMsg.style.display = visiveis === 0 ? 'block' : 'none';
            });
        }

        async function adicionarItem(id, btn) {
            btn.disabled = true;

            const resp = await fetch('/Pedido/AdicionarAoPedidoSilencioso', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
            });

            if (resp.ok) {
                btn.textContent = '✔ Adicionado!';
                btn.classList.add('adicionado');
                atualizarBadge(totalCarrinho + 1);
                setTimeout(() => {
                    btn.textContent = '➕ Adicionar';
                    btn.classList.remove('adicionado');
                    btn.disabled = false;
                }, 900);
            } else {
                btn.disabled = false;
            }
        }

        // Inicia contagem ao carregar
        carregarContadorCarrinho();
    </script>
    @Html.AntiForgeryToken()
}