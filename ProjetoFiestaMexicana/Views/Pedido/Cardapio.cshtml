@model IEnumerable<ProjetoFiestaMexicana.Models.Pratos>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cardápio";
}

<style>
    .ok {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 4px;
    }
</style>

<h2>Cardápio Fiesta Mexicana</h2>

<!-- Formulário de busca -->
<form method="get" asp-action="Cardapio" style="margin-bottom:10px">
    <input list="pratos" name="q" value="@ViewBag.q" placeholder="O que deseja comer hoje?..." style="width:300px" />
    <datalist id="pratos">
        @if (ViewBag.Titulos is IEnumerable<string> ts)
        {
            foreach (var t in ts)
            {
                <option value="@t"></option>
            }
        }
    </datalist>
    <button type="submit">Buscar</button>
    <a asp-action="Pedido" style="margin-left:10px">Ver meu pedido</a>
</form>

@if (TempData["ok"] != null)
{
    <div class="ok">@TempData["ok"]</div>
}

<!-- Grid de pratos -->
<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:12px">
    @foreach (var p in Model)
    {
        <div style="border:1px solid #eee; border-radius:8px; padding:10px; background: #fff;">
            <div style="height:220px; display:flex; align-items:center; justify-content:center; background:#fafafa; border-radius:6px; overflow:hidden">
                @if (!string.IsNullOrWhiteSpace(p.CapaArquivo))
                {
                    @* O caminho p.CapaArquivo já vem do banco como "capas/nome_da_foto.jpg" *@
                    <img src="~/@p.CapaArquivo" alt="@p.Nome" style="max-height:100%; max-width:100%" />
                }
                else
                {
                    <span style="color:#aaa">Sem foto</span>
                }
            </div>

            <div style="margin-top:8px; font-weight:600; font-size: 1.1rem;">@p.Nome</div>
            <div style="color: #059669; font-weight: bold; margin-bottom: 8px;">@p.Preco.ToString("C")</div>

            <form asp-action="AdicionarAoPedido" method="post" style="margin-top:8px">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@p.Id" />
                <button type="submit" style="width: 100%; padding: 8px; cursor: pointer; background: #2563eb; color: #fff; border: none; border-radius: 6px;">
                    Adicionar ao Pedido
                </button>
            </form>
        </div>
    }
</div>
