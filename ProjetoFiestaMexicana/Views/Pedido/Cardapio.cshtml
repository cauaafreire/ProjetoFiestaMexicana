@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cardápio — Garçom";
    var grupos = ViewBag.Grupos as Dictionary<string, List<ProjetoFiestaMexicana.Models.Pratos>>;
}

<style>
    .cardapio-area {
        padding: 24px;
        overflow-y: auto;
        background: #f9fafb;
        min-height: calc(100vh - 63px);
    }

    .cardapio-topo {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

        .cardapio-topo h1 {
            font-size: 1.4rem;
            font-weight: 800;
            color: #111827;
            margin: 0;
        }

    .busca-wrap {
        display: flex;
        gap: 8px;
        align-items: center;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 6px 12px;
        flex: 1;
        max-width: 300px;
    }

        .busca-wrap input {
            border: none;
            outline: none;
            font-size: 0.9rem;
            flex: 1;
            color: #111827;
        }

        .busca-wrap button {
            background: #FF5757;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 5px 12px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
        }

    /* Tabs */
    .cat-tabs {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .cat-tab {
        background: #fff;
        border: 2px solid #e5e7eb;
        color: #374151;
        border-radius: 50px;
        padding: 8px 18px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }

        .cat-tab:hover {
            border-color: #FF5757;
            color: #FF5757;
        }

        .cat-tab.ativa {
            background: #FF5757;
            border-color: #FF5757;
            color: #fff;
        }

    /* Seções */
    .cat-secao {
        display: none;
    }

        .cat-secao.ativa {
            display: block;
        }

    .cat-titulo {
        font-size: 0.88rem;
        font-weight: 800;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .cat-titulo::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e5e7eb;
        }

    /* Grid pratos */
    .pratos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 14px;
        margin-bottom: 32px;
    }

    .prato-card {
        background: #fff;
        border-radius: 14px;
        border: 2px solid #f3f4f6;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .prato-card:hover {
            border-color: #FF5757;
            box-shadow: 0 4px 16px rgba(255,87,87,0.12);
        }

    .prato-foto {
        width: 100%;
        height: 130px;
        background: #f3f4f6;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        flex-shrink: 0;
    }

        .prato-foto img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .prato-info {
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 3px;
        flex: 1;
    }

    .prato-nome {
        font-size: 0.88rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.3;
    }

    .prato-preco {
        font-size: 0.95rem;
        font-weight: 800;
        color: #FF5757;
    }

    .prato-desc {
        font-size: 0.73rem;
        color: #9ca3af;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-add-comanda {
        margin: 0 10px 10px;
        background: #111827;
        color: #fff;
        border: none;
        padding: 9px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        width: calc(100% - 20px);
        transition: background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

        .btn-add-comanda:hover {
            background: #FF5757;
        }

        .btn-add-comanda.adicionado {
            background: #059669;
        }
</style>

<div class="cardapio-area">
    <div class="cardapio-topo">
        <h1>🍽 Cardápio</h1>

        <p><a asp-action="Pedido" class="btn-novo">Nova Mesa</a></p>
        <form method="get" asp-action="Cardapio" class="busca-wrap">
            <input name="q" value="@ViewBag.q" placeholder="Buscar prato..." />
            <button type="submit">🔍</button>
        </form>
    </div>

    @if (grupos != null && grupos.Any())
    {
        <div class="cat-tabs">
            @for (int i = 0; i < grupos.Keys.Count; i++)
            {
                var cat = grupos.Keys.ElementAt(i);
                var ativa = i == 0 ? "ativa" : "";
                <button class="cat-tab @(ativa)" onclick="mostrarCat('@(cat)', this)">
                    @cat
                </button>
            }
        </div>

        @for (int i = 0; i < grupos.Keys.Count; i++)
        {
            var cat = grupos.Keys.ElementAt(i);
            var lista = grupos[cat];
            var ativa = i == 0 ? "ativa" : "";

            <div class="cat-secao @(ativa)" id="cat-@(i)" data-cat="@(cat)">
                <div class="cat-titulo">@cat</div>
                <div class="pratos-grid">
                    @for (int j = 0; j < lista.Count; j++)
                    {
                        var p = lista[j];
                        <div class="prato-card">
                            <div class="prato-foto">
                                @if (!string.IsNullOrWhiteSpace(p.CapaArquivo))
                                {
                                    <img src="~/@(p.CapaArquivo)" alt="@(p.Nome)" />
                                }
                                else
                                {
                                    <span>🌶️</span>
                                }
                            </div>
                            <div class="prato-info">
                                <div class="prato-nome">@(p.Nome)</div>
                                <div class="prato-preco">@(p.Preco.ToString("C"))</div>
                                @if (!string.IsNullOrEmpty(p.Descricao))
                                {
                                    <div class="prato-desc">@(p.Descricao)</div>
                                }
                            </div>
                            <button class="btn-add-comanda" id="btn-@(p.Id)"
                                    onclick="adicionarItem(@(p.Id), '@(p.Nome.Replace("'", "\\'"))', @(p.Preco.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)), '@(p.CapaArquivo ?? "")')">
                                ➕ Adicionar
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div style="text-align:center;padding:60px;color:#9ca3af;">Nenhum prato disponível.</div>
    }
</div>

@section Scripts {
    <script>
        function mostrarCat(nome, btn) {
            document.querySelectorAll('.cat-secao').forEach(s => s.classList.remove('ativa'));
            document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('ativa'));
            document.querySelectorAll('.cat-secao').forEach(s => {
                if (s.dataset.cat === nome) s.classList.add('ativa');
            });
            if (btn) btn.classList.add('ativa');
        }

        // Esta função será chamada pelo botão "Adicionar",
        // mas a lógica da comanda fica no Pedido.cshtml.
        // Adapte conforme a comunicação entre as duas views (ex: session, redirect, etc.)
        function adicionarItem(id, nome, preco, foto) {
            // Redireciona para a action que adiciona o item ao carrinho em sessão
            fetch('/Pedido/AdicionarAoPedidoSilencioso', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${id}&__RequestVerificationToken=${document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''}`
            }).then(() => {
                const btn = document.getElementById('btn-' + id);
                if (btn) {
                    btn.textContent = '✔ Adicionado!';
                    btn.classList.add('adicionado');
                    setTimeout(() => {
                        btn.textContent = '➕ Adicionar';
                        btn.classList.remove('adicionado');
                    }, 900);
                }
            });
        }
    </script>
    @Html.AntiForgeryToken()
}