@model ProjetoFiestaMexicana.Models.Pratos
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Nome;
}

<style>
    .det-page {
        max-width: 960px;
        margin: 40px auto;
        padding: 0 20px 60px;
    }

    /* Breadcrumb */
    .det-breadcrumb {
        font-size: 0.82rem;
        color: #9ca3af;
        margin-bottom: 28px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .det-breadcrumb a {
            color: #6b7280;
            text-decoration: none;
        }

            .det-breadcrumb a:hover {
                color: #FF5757;
            }

    /* Layout principal: foto esquerda, info direita */
    .det-main {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        align-items: start;
    }

    /* Foto */
    .det-foto-wrap {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        background: #f3f4f6;
        aspect-ratio: 1 / 1;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 32px rgba(0,0,0,0.10);
    }

        .det-foto-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .det-foto-placeholder {
        font-size: 5rem;
    }

    /* Info */
    .det-info {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .det-categoria {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #FF5757;
    }

    .det-nome {
        font-size: 2rem;
        font-weight: 800;
        color: #111827;
        line-height: 1.2;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .det-preco {
        display: flex;
        align-items: baseline;
        gap: 4px;
        line-height: 1;
    }

    .det-preco-cifrao {
        font-size: 1.2rem;
        font-weight: 700;
        color: #111827;
        align-self: flex-start;
        margin-top: 6px;
    }

    .det-preco-valor {
        font-size: 2.8rem;
        font-weight: 800;
        color: #111827;
    }

    /* Tags de info */
    .det-tags {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .det-tag {
        background: #f3f4f6;
        color: #374151;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    /* Accordion "O que tem?" */
    .det-accordion {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
    }

    .det-accordion-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        background: #f9fafb;
        cursor: pointer;
        user-select: none;
        transition: background 0.15s;
    }

        .det-accordion-header:hover {
            background: #f3f4f6;
        }

        .det-accordion-header span:first-child {
            font-size: 0.82rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #374151;
        }

    .det-accordion-icon {
        font-size: 1rem;
        color: #6b7280;
        transition: transform 0.2s;
    }

    .det-accordion-body {
        padding: 16px 20px;
        font-size: 0.92rem;
        color: #4b5563;
        line-height: 1.7;
        border-top: 1px solid #e5e7eb;
    }

    /* Botão voltar */
    .btn-voltar {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: none;
        border: 2px solid #e5e7eb;
        color: #374151;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        margin-top: 8px;
    }

        .btn-voltar:hover {
            border-color: #FF5757;
            color: #FF5757;
        }

    /* Responsivo */
    @@media (max-width: 680px) {
        .det-main {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .det-nome {
            font-size: 1.5rem;
        }

        .det-preco-valor {
            font-size: 2rem;
        }
    }
</style>

<div class="det-page">

    <!-- Breadcrumb -->
    <div class="det-breadcrumb">
        <a href="/Pedido/Menu">Cardápio</a>
        <span>›</span>
        @if (!string.IsNullOrEmpty(Model.CategoriaNome))
        {
            <span>@Model.CategoriaNome</span>
            <span>›</span>
        }
        <span style="color:#111827; font-weight:600;">@Model.Nome</span>
    </div>

    <div class="det-main">

        <!-- Foto -->
        <div class="det-foto-wrap">
            @if (!string.IsNullOrWhiteSpace(Model.CapaArquivo))
            {
                <img src="~/@(Model.CapaArquivo)" alt="@(Model.Nome)" />
            }
            else
            {
                <div class="det-foto-placeholder">🌶️</div>
            }
        </div>

        <!-- Informações -->
        <div class="det-info">

            @if (!string.IsNullOrEmpty(Model.CategoriaNome))
            {
                <div class="det-categoria">@(Model.CategoriaNome)</div>
            }

            <div class="det-nome">@(Model.Nome)</div>

            <div class="det-preco">
                <span class="det-preco-cifrao">R$</span>
                <span class="det-preco-valor">@(Model.Preco.ToString("N2"))</span>
            </div>

            <!-- Tags: picância e tempo -->
            @{
                bool temTags = !string.IsNullOrEmpty(Model.NivelPicancia) || Model.TempoPreparo.HasValue;
            }
            @if (temTags)
            {
                <div class="det-tags">
                    @if (!string.IsNullOrEmpty(Model.NivelPicancia) && Model.NivelPicancia != "Sem Pimenta")
                    {
                        <span class="det-tag">🔥 @(Model.NivelPicancia)</span>
                    }
                    @if (Model.TempoPreparo.HasValue)
                    {
                        <span class="det-tag">⏱️ @(Model.TempoPreparo) min</span>
                    }
                </div>
            }

            <!-- Accordion: descrição -->
            @if (!string.IsNullOrWhiteSpace(Model.Descricao))
            {
                <div class="det-accordion">
                    <div class="det-accordion-header" onclick="toggleAcc()">
                        <span>O QUE TEM?</span>
                        <span class="det-accordion-icon" id="accIcon">∧</span>
                    </div>
                    <div class="det-accordion-body" id="accBody">
                        @(Model.Descricao)
                    </div>
                </div>
            }

            <a href="/Pedido/Menu" class="btn-voltar">← Voltar ao Cardápio</a>

        </div>
    </div>
</div>

<script>
    function toggleAcc() {
        const body = document.getElementById('accBody');
        const icon = document.getElementById('accIcon');
        const aberto = body.style.display !== 'none';
        body.style.display = aberto ? 'none' : 'block';
        icon.textContent = aberto ? '∨' : '∧';
    }
</script>