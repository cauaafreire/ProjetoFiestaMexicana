@using ProjetoFiestaMexicana.Autenticacao
@{
    var isLogged = Context.Session.GetInt32(SessionKeys.UserId).HasValue;
    var role = Context.Session.GetString(SessionKeys.UserRole);
    var userName = Context.Session.GetString(SessionKeys.UserName);
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Biblioteca</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
    <style>
       
        body {
            font-family: system-ui,Segoe UI,Roboto,Arial,sans-serif;
            margin: 0
        }

        .topnav {
            display: flex;
            gap: 12px;
            align-items: center;
            padding: 10px 16px;
            border-bottom: 1px solid #eee;
            background: #fff;
            top: 0 ;
            font-weight: 500;
        }

            .topnav a {
                text-decoration: none;
                color: #111;
                
            }

        .logo-icone {
            height: 45px; 
            width: auto;
            margin-right: 30px
        }

        .butlogout {
            background: #D21E1E;
            color: #fff ;
            cursor: pointer;
            border-radius: 4px;
            border: 1px solid #D21E1E;
            height: 25px;
            width: 50px;
            margin-top: 2px;
        }

        .spacer {
            flex: 1
        }

            .btn-link:hover {
                background: #e6f0ff
            }

        .container {
            padding: 20px
        }
    </style>
</head>
<body>
    <header>
        @if (isLogged)
        {
            <nav class="topnav">

                <a asp-controller="Home" asp-action="Index">
                    <img src="~/logos/iconef.png" alt="Logo" class="logo-icone" />
                </a>

                <a asp-controller="Pratos" asp-action="Index">Pratos</a>
                <a asp-controller="Cozinha" asp-action="Index">Cozinha</a>
                <a asp-controller="Categoria" asp-action="Index">Categoria</a>
                <a asp-controller="MetodoPreparo" asp-action="Index">Metodo de Preparo</a>
                <a asp-controller="Mesa" asp-action="Index">Mesa</a>
                <a asp-controller="Garcom" asp-action="Index">Garçom</a>

                <a asp-controller="Pedido" asp-action="Cardapio" class="me-auto">Cardapio</a>

                @if (role == "Adm")
                {
                    <a asp-controller="Usuarios" asp-action="CriarUsuario" class="me-3">Usuários</a>
                }


                <span class="spacer"></span>

                <span>Olá, @userName</span>
                <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="butlogout">Sair</button>
                </form>
            </nav>

        }
    </header>

    <main role="main" class="container">
        @RenderBody()
    </main>

    @RenderSection("Scripts", required: false)
</body>
</html>
