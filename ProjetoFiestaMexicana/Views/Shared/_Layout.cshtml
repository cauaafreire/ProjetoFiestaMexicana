@using ProjetoFiestaMexicana.Autenticacao
@{
    var isLogged = Context.Session.GetInt32(SessionKeys.UserId).HasValue;
    var role = Context.Session.GetString(SessionKeys.UserRole) ?? "";
    var userName = Context.Session.GetString(SessionKeys.UserName) ?? "";

    bool isAdmin = role == "Admin";
    bool isChefe = role == "Chefe" || isAdmin;
    bool isGarcom = role == "Garcom" || isAdmin;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Fiesta Mexicana</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: system-ui, Segoe UI, Roboto, Arial, sans-serif;
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── Navbar ── */
        .topnav {
            display: flex;
            align-items: center;
            padding: 10px 16px;
            border-bottom: 1px solid #eee;
            background: #fff;
            font-weight: 500;
            flex-shrink: 0;
            gap: 12px;
        }

            .topnav a {
                text-decoration: none;
                color: #111;
                font-size: 0.9rem;
            }

                .topnav a:hover {
                    color: #FF5757;
                }

        .logo-icone {
            height: 42px;
            width: auto;
            margin-right: 8px;
        }

        .spacer {
            flex: 1;
        }

        .butlogout {
            background: #D21E1E;
            color: #fff;
            cursor: pointer;
            border-radius: 4px;
            border: none;
            height: 28px;
            padding: 0 14px;
            font-weight: 600;
            font-size: 0.85rem;
        }

            .butlogout:hover {
                background: #b91c1c;
            }

        .btn-entrar {
            background: #FF5757;
            color: #fff !important;
            border: none;
            padding: 7px 20px;
            border-radius: 6px;
            font-size: 0.88rem;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-entrar:hover {
                background: #e04444;
            }

        /* Links e área direita — visíveis só no desktop */
        .nav-links {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* ── Hamburger ── */
        .hamburger {
            display: none;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 6px;
            margin-left: auto;
        }

            .hamburger span {
                display: block;
                width: 24px;
                height: 2px;
                background: #111;
                border-radius: 2px;
                transition: all 0.3s;
            }

            .hamburger.aberto span:nth-child(1) {
                transform: translateY(7px) rotate(45deg);
            }

            .hamburger.aberto span:nth-child(2) {
                opacity: 0;
            }

            .hamburger.aberto span:nth-child(3) {
                transform: translateY(-7px) rotate(-45deg);
            }

        /* ── Overlay ── */
        .drawer-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            z-index: 998;
        }

            .drawer-overlay.aberto {
                display: block;
            }

        /* ── Drawer ── */
        .drawer {
            position: fixed;
            top: 0;
            right: -290px;
            width: 275px;
            height: 100%;
            background: #fff;
            z-index: 999;
            box-shadow: -4px 0 24px rgba(0,0,0,0.15);
            display: flex;
            flex-direction: column;
            transition: right 0.3s ease;
            overflow-y: auto;
        }

            .drawer.aberto {
                right: 0;
            }

        .drawer-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 20px;
            border-bottom: 1px solid #f3f4f6;
        }

            .drawer-header img {
                height: 36px;
                width: auto;
            }

        .drawer-fechar {
            background: none;
            border: none;
            font-size: 1.4rem;
            cursor: pointer;
            color: #374151;
            line-height: 1;
            padding: 4px;
        }

            .drawer-fechar:hover {
                color: #FF5757;
            }

        .drawer-nav {
            display: flex;
            flex-direction: column;
            flex: 1;
            padding: 8px 0;
        }

            .drawer-nav a {
                padding: 14px 24px;
                color: #111827;
                text-decoration: none;
                font-size: 0.95rem;
                font-weight: 600;
                border-bottom: 1px solid #f9fafb;
                transition: background 0.15s, color 0.15s;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .drawer-nav a:hover {
                    background: #fff5f5;
                    color: #FF5757;
                }

        .drawer-footer {
            padding: 20px 24px;
            border-top: 1px solid #f3f4f6;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .drawer-user {
            font-size: 0.85rem;
            color: #6b7280;
            font-weight: 500;
        }

        .btn-entrar-drawer {
            background: #FF5757;
            color: #fff;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            display: block;
        }

            .btn-entrar-drawer:hover {
                background: #e04444;
                color: #fff;
            }

        .butlogout-drawer {
            background: #D21E1E;
            color: #fff;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
        }

            .butlogout-drawer:hover {
                background: #b91c1c;
            }

        /* ── Responsivo ── */
        @@media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .nav-right {
                display: none;
            }

            .hamburger {
                display: flex;
            }
        }

        /* ── Main e container ── */
        main {
            flex: 1;
        }

        .container {
            padding: 20px;
        }

        /* ── Footer ── */
        .site-footer {
            background: #FF5757;
            color: #fff;
            padding: 40px 20px 20px;
            margin-top: auto;
            flex-shrink: 0;
        }

        .footer-inner {
            max-width: 1700px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: auto 1fr 1fr;
            gap: 40px;
            align-items: start;
        }

        .footer-logo-col {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .footer-logo-img {
            width: 100px;
            height: 100px;
            object-fit: contain;
            border-radius: 12px;
            padding: 5px;
        }

        .red-icon {
            width: 35px;
            height: 35px;
        }

        .footer-redes {
            display: flex;
            gap: 12px;
            align-items: center;
        }

            .footer-redes a {
                color: rgba(255,255,255,0.85);
                text-decoration: none;
                font-size: 1.2rem;
                transition: color 0.2s;
            }

                .footer-redes a:hover {
                    color: #fff;
                }

        .footer-bottom {
            max-width: 1800px;
            margin: 30px auto 0;
            padding-top: 16px;
            border-top: 1px solid rgba(255,255,255,0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.78rem;
            color: rgba(255,255,255,0.65);
        }

        @@media (max-width: 640px) {
            .footer-inner {
                grid-template-columns: 1fr 1fr;
            }

            .footer-logo-col {
                grid-column: span 2;
                flex-direction: row;
                align-items: center;
            }
        }
    </style>
</head>
<body>

    <header>
        <nav class="topnav">
            <!-- Logo -->
            <a asp-controller="Pedido" asp-action="Menu">
                <img src="~/logos/iconef.png" alt="Logo" class="logo-icone" />
            </a>

            <!-- Links desktop -->
            <div class="nav-links">
                @if (isLogged)
                {
                    @if (isGarcom)
                    {
                        <a asp-controller="Mesa" asp-action="Index">Mesa</a>
                        <a asp-controller="Pedido" asp-action="Cardapio">Cardápio</a>
                        <a asp-controller="Pedido" asp-action="Comandas">Comandas</a>
                    }
                    @if (isChefe)
                    {
                        <a asp-controller="Pratos" asp-action="Index">Pratos</a>
                        <a asp-controller="Cozinha" asp-action="Index">Cozinha</a>
                        <a asp-controller="Categoria" asp-action="Index">Categoria</a>
                        <a asp-controller="MetodoPreparo" asp-action="Index">Método de Preparo</a>
                    }
                    @if (isAdmin)
                    {
                        <a asp-controller="Garcom" asp-action="Index">Garçom</a>
                        <a asp-controller="Usuario" asp-action="Index">Usuários</a>
                        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    }
                }
            </div>

            <!-- Direita desktop -->
            <div class="nav-right">
                @if (isLogged)
                {
                    <span style="color:#6b7280; font-size:0.85rem;">Olá, @userName</span>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="butlogout">Sair</button>
                    </form>
                }
                else
                {
                    <a href="/Auth/Login" class="btn-entrar">ENTRAR</a>
                }
            </div>

            <!-- Hamburger mobile -->
            <button class="hamburger" id="hamburger" onclick="toggleDrawer()" aria-label="Menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </nav>
    </header>

    <!-- Overlay -->
    <div class="drawer-overlay" id="drawerOverlay" onclick="fecharDrawer()"></div>

    <!-- Drawer -->
    <div class="drawer" id="drawer">
        <div class="drawer-header">
            <img src="~/logos/iconef.png" alt="Logo" />
            <button class="drawer-fechar" onclick="fecharDrawer()">✕</button>
        </div>

        <nav class="drawer-nav">
            <a asp-controller="Pedido" asp-action="Menu">🏠 Início</a>

            @if (isLogged)
            {
                @if (isGarcom)
                {
                    <a asp-controller="Mesa" asp-action="Index">🪑 Mesa</a>
                    <a asp-controller="Pedido" asp-action="Cardapio">📋 Cardápio</a>
                    <a asp-controller="Pedido" asp-action="Comandas">🧾 Comandas</a>
                }
                @if (isChefe)
                {
                    <a asp-controller="Pratos" asp-action="Index">🍽 Pratos</a>
                    <a asp-controller="Cozinha" asp-action="Index">👨‍🍳 Cozinha</a>
                    <a asp-controller="Categoria" asp-action="Index">📂 Categoria</a>
                    <a asp-controller="MetodoPreparo" asp-action="Index">📖 Método de Preparo</a>
                }
                @if (isAdmin)
                {
                    <a asp-controller="Garcom" asp-action="Index">🤵 Garçom</a>
                    <a asp-controller="Usuario" asp-action="Index">👥 Usuários</a>
                    <a asp-controller="Dashboard" asp-action="Index">📊Dashboard</a>
                }
            }
        </nav>

        <div class="drawer-footer">
            @if (isLogged)
            {
                <div class="drawer-user">Olá, @userName</div>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="butlogout-drawer">Sair</button>
                </form>
            }
            else
            {
                <a href="/Auth/Login" class="btn-entrar-drawer">ENTRAR</a>
            }
        </div>
    </div>

    <main role="main" class="@(isLogged ? "container" : "")">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-logo-col">
                <img src="~/logos/logof.png" alt="Fiesta mexicana" class="footer-logo-img" />
                <div class="footer-redes">
                    <a href="#" title="X / Twitter"><img src="~/logos/icon/icons8-x-60.png" alt="X" class="red-icon" /></a>
                    <a href="#" title="Instagram"><img src="~/logos/icon/icons8-instagram-logo-60.png" alt="Instagram" class="red-icon" /></a>
                    <a href="#" title="LinkedIn"><img src="~/logos/icon/icons8-linkedin-50.png" alt="Linkedin" class="red-icon" /></a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.Now.Year Fiesta Mexicana. Todos os direitos reservados.</span>
            <span>Feito por <strong>SkullTech</strong></span>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)

    <script>
        function toggleDrawer() {
            const drawer  = document.getElementById('drawer');
            const overlay = document.getElementById('drawerOverlay');
            const burger  = document.getElementById('hamburger');
            const aberto  = drawer.classList.contains('aberto');

            if (aberto) {
                fecharDrawer();
            } else {
                drawer.classList.add('aberto');
                overlay.classList.add('aberto');
                burger.classList.add('aberto');
                document.body.style.overflow = 'hidden';
            }
        }

        function fecharDrawer() {
            document.getElementById('drawer').classList.remove('aberto');
            document.getElementById('drawerOverlay').classList.remove('aberto');
            document.getElementById('hamburger').classList.remove('aberto');
            document.body.style.overflow = '';
        }

        // Fecha com ESC
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') fecharDrawer();
        });
    </script>

</body>
</html>