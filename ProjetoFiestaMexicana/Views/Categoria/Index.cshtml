@model IEnumerable<ProjetoFiestaMexicana.Models.Categoria>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Categorias";
}

<link href="~/css/tables.css" rel="stylesheet" />

<div class="page-container">

<h2>Categorias</h2>

@if (TempData["ok"] != null)
{
    <div class="ok">@TempData["ok"]</div>
}

<p><a asp-action="Criar" class="btn-novo" >Nova Categoria</a></p>


<div class="table-responsive">
    <table class="tbl">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Criado Em</th>
                <th class="col-acoes">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Nome</td>
                    <td>@c.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="col-acoes">
                        <div class="acoes">
                            <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-editar">Editar</a>
                            <form asp-action="Excluir" method="post" onsubmit="return confirm(\'Excluir esta categoria?\');">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-excluir">Excluir</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>