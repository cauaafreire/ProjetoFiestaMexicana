@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sobre Nós";
}

<style>

    html, body {
        margin: 0 !important;
        padding: 0 !important;
    }

    main {
        padding: 0 !important;
        margin: 0 !important;
    }


    .sobre-page {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
    }

    /* Força o container a ocupar a tela toda */
    .container {
        max-width: 100% !important;
        width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }


    .container-sobre {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 24px;
    }


    .hero-bg {
        position: relative;
        min-height: 560px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        background-image: url('/images/fotodefundof.png');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

        .hero-bg::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(30, 10, 0, 0.68);
        }

    .hero-conteudo {
        position: relative;
        z-index: 1;
        padding: 60px 24px;
        max-width: 720px;
        margin: 0 auto;
    }

    .hero-tag {
        display: inline-block;
        background: #FF5757;
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 5px 16px;
        border-radius: 20px;
        margin-bottom: 22px;
    }

    .hero-bg h1 {
        font-size: 3.2rem;
        font-weight: 900;
        color: #fff;
        line-height: 1.1;
        margin: 0 0 18px;
        border: none;
        display: block;
        padding: 0;
    }

        .hero-bg h1 span {
            color: #FF5757;
        }

    .hero-bg p {
        font-size: 1.05rem;
        color: rgba(255,255,255,0.8);
        line-height: 1.8;
        margin-bottom: 32px;
    }

    .hero-btns {
        display: flex;
        gap: 14px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-hero-prim {
        background: #FF5757;
        color: #fff !important;
        padding: 13px 30px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-hero-prim:hover {
            background: #e04444;
        }

    .btn-hero-sec {
        background: transparent;
        color: #fff !important;
        padding: 13px 30px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none;
        border: 2px solid rgba(255,255,255,0.5);
        transition: border-color 0.2s;
    }

        .btn-hero-sec:hover {
            border-color: #fff;
        }

    .stats-bar {
        background: #2d1a0e;
        padding: 36px 24px;
    }

    .stats-inner {
        max-width: 900px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        text-align: center;
    }

    .stat-item h3 {
        font-size: 2.2rem;
        font-weight: 900;
        color: #FF5757;
        margin: 0 0 4px;
    }

    .stat-item p {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.65);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        margin: 0;
    }

    .secao {
        max-width: 960px;
        margin: 0 auto;
        padding: 72px 24px;
    }

    .s-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2.5px;
        color: #FF5757;
        margin-bottom: 8px;
        display: block;
    }

    .s-titulo {
        font-size: 1.9rem;
        font-weight: 800;
        color: #2d1a0e;
        margin: 0 0 14px;
        border: none;
        display: block;
        padding: 0;
        line-height: 1.2;
    }

    .s-sub {
        font-size: 0.95rem;
        color: #666;
        line-height: 1.8;
        max-width: 640px;
        margin-bottom: 44px;
    }

    .historia-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 52px;
        align-items: center;
    }

    .historia-texto p {
        font-size: 0.93rem;
        color: #444;
        line-height: 1.9;
        margin-bottom: 16px;
    }

    .historia-img-box {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        min-height: 380px;

        background-image: url('/images/historia.jfif');
        background-size: cover;
        background-position: center;
    }

        .historia-img-box::after {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(30,10,0,0.25);
            border-radius: 20px;
        }

    .historia-badge {
        position: absolute;
        bottom: 24px;
        left: 24px;
        z-index: 1;
        background: #FF5757;
        color: #fff;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .tradicao-section {
        position: relative;
        min-height: 480px;
        display: flex;
        align-items: center;
        overflow: hidden;
        background-image: url('/images/fotodefundo2.jfif');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

        .tradicao-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(20, 8, 0, 0.75);
        }

    .tradicao-conteudo {
        position: relative;
        z-index: 1;
        max-width: 960px;
        margin: 0 auto;
        padding: 72px 24px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
        width: 100%;
    }

    .tradicao-texto .s-label {
        color: #FF5757;
    }

    .tradicao-texto .s-titulo {
        color: #fff;
        margin-bottom: 18px;
    }

    .tradicao-texto p {
        color: rgba(255,255,255,0.78);
        font-size: 0.93rem;
        line-height: 1.85;
        margin-bottom: 14px;
    }

    .tradicao-cards {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .trad-card {
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 14px;
        padding: 20px 22px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .trad-card-icone {
        font-size: 1.6rem;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .trad-card h4 {
        font-size: 0.88rem;
        font-weight: 700;
        color: #fff;
        margin: 0 0 4px;
    }

    .trad-card p {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.6);
        margin: 0;
        line-height: 1.5;
    }

    /* ── Carrossel de pratos ── */
    .carrossel-section {
        background: #fdf6f0;
        padding: 72px 24px;
        border-top: 1px solid #f0e0d0;
    }

    .carrossel-inner {
        max-width: 960px;
        margin: 0 auto;
    }

    .carrossel-wrap {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        margin-top: 40px;
    }

    .carrossel-track {
        display: flex;
        transition: transform 0.4s ease;
    }

    .carrossel-slide {
        min-width: 100%;
        background: #2d1a0e;
        border-radius: 20px;
        padding: 52px 56px;
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 40px;
        align-items: center;
    }

    .slide-icone {
        font-size: 5rem;
        line-height: 1;
    }

    .slide-info h3 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 8px;
    }

    .slide-tag {
        display: inline-block;
        background: rgba(255,87,87,0.2);
        color: #FF5757;
        border: 1px solid rgba(255,87,87,0.4);
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 12px;
        margin-bottom: 14px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .slide-info p {
        font-size: 0.9rem;
        color: rgba(255,255,255,0.72);
        line-height: 1.8;
        max-width: 520px;
    }

    /* ── Carrossel de pratos (Design Refinado) ── */
    .carrossel-section {
        background: #fdf6f0;
        padding: 80px 24px;
        border-top: 1px solid #f0e0d0;
    }

    .carrossel-inner {
        max-width: 1000px;
        margin: 0 auto;
    }

    .carrossel-wrap {
        position: relative;
        overflow: hidden;
        border-radius: 25px;
        margin-top: 40px;
        box-shadow: 0 10px 30px rgba(45, 26, 14, 0.1);
    }

    .carrossel-track {
        display: flex;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .carrossel-slide {
        min-width: 100%;
        background: #2d1a0e;
        padding: 50px;
        display: grid;
        grid-template-columns: 250px 1fr;
        gap: 40px;
        align-items: center;
        color: #fff;
    }

    .slide-img-box {
        width: 250px;
        height: 250px;
        border-radius: 20px;
        overflow: hidden;
        border: 4px solid rgba(255, 87, 87, 0.3);
    }

        .slide-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .slide-info h3 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .slide-preco {
        display: inline-block;
        color: #FF5757;
        font-weight: 900;
        font-size: 1.4rem;
        margin-bottom: 15px;
        background: rgba(255, 87, 87, 0.1);
        padding: 4px 12px;
        border-radius: 8px;
    }

    .slide-tag {
        display: inline-block;
        background: rgba(255, 87, 87, 0.2);
        color: #FF5757;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 14px;
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .slide-info p {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.7;
    }

    .carrossel-nav {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 25px;
    }

    .carrossel-btn {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 2px solid #FF5757;
        background: #fff;
        color: #FF5757;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .carrossel-btn:hover {
            background: #FF5757;
            color: #fff;
        }

    .carrossel-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #ccc;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
    }

        .carrossel-dot.ativo {
            background: #FF5757;
            width: 25px;
            border-radius: 10px;
        }

    @@media (max-width: 768px) {
        .carrossel-slide {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 30px;
        }

        .slide-img-box {
            margin: 0 auto;
            width: 200px;
            height: 200px;
        }
    }


    /* ── Diferenciais (Design 2x2 Centralizado) ── */
    .diferenciais-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr); /* 2 colunas */
        gap: 25px;
        max-width: 850px; /* Limita a largura para centralizar o bloco */
        margin: 40px auto 0; /* Centraliza na página */
    }

    .dif-card {
        background: #fff;
        border-radius: 20px;
        padding: 40px 30px;
        text-align: center;
        border: 1px solid #f0e0d0;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        /* Enfeite: Linha colorida no topo de cada card */
        .dif-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: #FF5757;
            opacity: 0.7;
        }

        .dif-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 30px rgba(255, 87, 87, 0.12);
            border-color: #FF5757;
        }

        .dif-card h3 {
            font-size: 1rem;
            font-weight: 800;
            color: #2d1a0e;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .dif-card p {
            font-size: 0.9rem;
            color: #666;
            line-height: 1.6;
        }

    /* Ajuste para celulares: vira 1 coluna */
    @@media (max-width: 600px) {
        .diferenciais-grid {
            grid-template-columns: 1fr;
        }
    }


    /* ── FAQ ── */
    .faq-section {
        background: #fdf6f0;
        padding: 72px 24px;
    }

    .faq-inner {
        max-width: 720px;
        margin: 0 auto;
    }

    .faq-lista {
        margin-top: 40px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .faq-item {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #f0e0d0;
        overflow: hidden;
    }

    .faq-pergunta {
        width: 100%;
        background: none;
        border: none;
        padding: 20px 24px;
        text-align: left;
        font-size: 0.93rem;
        font-weight: 700;
        color: #2d1a0e;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        transition: background 0.15s;
    }

        .faq-pergunta:hover {
            background: #fff8f5;
        }

    .faq-icone {
        font-size: 1.2rem;
        color: #FF5757;
        transition: transform 0.3s;
        flex-shrink: 0;
    }

    .faq-item.aberto .faq-icone {
        transform: rotate(45deg);
    }

    .faq-resposta {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.35s ease, padding 0.35s ease;
        padding: 0 24px;
        font-size: 0.88rem;
        color: #555;
        line-height: 1.8;
    }

    .faq-item.aberto .faq-resposta {
        max-height: 300px;
        padding: 0 24px 20px;
    }

    /* ── CTA final ── */
    .cta-final {
        position: relative;
        min-height: 340px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        background-image: url('');
        background-size: cover;
        background-position: center;
    }

        .cta-final::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(20,8,0,0.72);
        }

    .cta-conteudo {
        position: relative;
        z-index: 1;
        padding: 60px 24px;
    }

    .cta-final h2 {
        font-size: 2.2rem;
        font-weight: 900;
        color: #fff;
        border: none;
        display: block;
        padding: 0;
        margin-bottom: 14px;
    }

    .cta-final p {
        color: rgba(255,255,255,0.75);
        font-size: 1rem;
        margin-bottom: 30px;
        line-height: 1.7;
    }

    /* ── Responsivo ── */
    @@media (max-width: 768px) {
        .hero-bg h1 {
            font-size: 2.1rem;
        }

        .stats-inner {
            grid-template-columns: repeat(2, 1fr);
        }

        .historia-grid {
            grid-template-columns: 1fr;
        }

        .historia-img-box {
            min-height: 260px;
        }

        .tradicao-conteudo {
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .diferenciais-grid {
            grid-template-columns: 1fr 1fr;
        }

        .carrossel-slide {
            grid-template-columns: 1fr;
            padding: 32px 24px;
            text-align: center;
        }
    }

    @@media (max-width: 480px) {
        .stats-inner {
            grid-template-columns: 1fr 1fr;
        }

        .diferenciais-grid {
            grid-template-columns: 1fr;
        }

        .hero-btns {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

<div class="sobre-page">

    <!-- ── Hero ── -->
    <div class="hero-bg">
        <div class="hero-conteudo">
            <span class="hero-tag">Fiesta Mexicana</span>
            <h1>O verdadeiro sabor<br>do <span>México</span> em SP</h1>
            <p>Culinária mexicana autêntica, temperos selecionados e um ambiente que transporta você direto para as ruas do México.</p>
            <div class="hero-btns">
                <a asp-controller="Pedido" asp-action="Menu" class="btn-hero-prim">Ver Menu</a>
                <a href="#tradicao" class="btn-hero-sec">Nossa História</a>
            </div>
        </div>
    </div>

    <div class="stats-bar">
        <div class="stats-inner">
            <div class="stat-item">
                <h3>Chefes</h3>
                <p>Especialistas em culinária mexicana</p>
            </div>
            <div class="stat-item">
                <h3>100%</h3>
                <p>Receitas autênticas</p>
            </div>
            <div class="stat-item">
                <h3>+3</h3>
                <p>Anos de história</p>
            </div>
            <div class="stat-item">
                <h3>+100</h3>
                <p>Festas e eventos realizados</p>
            </div>
        </div>
    </div>

    <div class="secao">
        <span class="s-label">Nossa história</span>
        <div class="historia-grid">
            <div class="historia-texto">
                <span class="s-titulo">Do México para<br>a sua mesa</span>
                <p>A Fiesta Mexicana nasceu de uma paixão genuína pela culinária mexicana — aquela comida de rua, popular, cheia de tempero e história. Nossa missão é simples: trazer para São Paulo a autenticidade dos sabores do centro e sudoeste do México, sem adaptações que comprometam a essência.</p>
                <p>Cada prato é preparado com ingredientes selecionados, seguindo receitas tradicionais que passam de geração em geração. Nossas tortillas são de milho, como manda a tradição. Nosso molho chillibeans segue preparo especificamente mexicano — frijoles fritos, amassados e condimentados do jeito certo.</p>
                <p>Aqui você não encontra Tex-Mex. Encontra o México de verdade.</p>
            </div>
            <div class="historia-img-box">
                <div class="historia-badge"> Culinária 100% Autêntica</div>
            </div>
        </div>
    </div>

    <!-- ── Tradição e Cultura ── -->
    <div class="tradicao-section" id="tradicao">
        <div class="tradicao-conteudo">
            <div class="tradicao-texto">
                <span class="s-label">Tradição & Cultura</span>
                <span class="s-titulo">Mais que comida —<br>uma experiência cultural</span>
                <p>No Mexicaníssimo, a cozinha é tratada com rigor, técnica e respeito às origens. Nosso ambiente foi criado para transportar você: decoração temática, música ao vivo e um atendimento que faz você se sentir em casa — mesmo estando no coração de São Paulo.</p>
                <p>Cada visita é uma imersão. Cada prato, uma história contada com sabor.</p>
            </div>
            <div class="tradicao-cards">
                <div class="trad-card">
                    <div>
                        <h4>Tortillas de milho artesanais</h4>
                        <p>Feitas na hora, seguindo a tradição mexicana original — sem trigo, sem compromisso com a autenticidade.</p>
                    </div>
                </div>
                <div class="trad-card">

                    <div>
                        <h4>Temperos importados do México</h4>
                        <p>Usamos pimentas e especiarias selecionadas diretamente de fornecedores mexicanos para garantir o sabor real.</p>
                    </div>
                </div>
                <div class="trad-card">
                    <span class="trad-card-icone"></span>
                    <div>
                        <h4>Ambiente temático</h4>
                        <p>Decoração, música e atmosfera que fazem você viajar sem sair de São Paulo.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="carrossel-section">
        <div class="carrossel-inner">
            <span class="s-label">Destaques</span>
            <span class="s-titulo">Pratos que você precisa experimentar</span>
            <p class="s-sub">Uma seleção especial dos nossos 5 sabores mais amados.</p>

            <div class="carrossel-wrap">
                <div class="carrossel-track" id="carrosselTrack">
                    @if (Model != null && Model.Count > 0)
                    {
                        @for (int i = 0; i < Math.Min(Model.Count, 5); i++)
                        {
                            var prato = Model[i];
                            <div class="carrossel-slide">
                                <div class="slide-img-box">
                                    <img src="/@(string.IsNullOrEmpty(prato.CapaArquivo) ? "images/sem-foto.png" : prato.CapaArquivo)" alt="@prato.Nome" />
                                </div>
                                <div class="slide-info">
                                    <span class="slide-tag">@(prato.CategoriaNome ?? "Especialidade")</span>
                                    <h3>@prato.Nome</h3>
                                    <span class="slide-preco">R$ @prato.Preco.ToString("N2")</span>
                                    <p>@(prato.Descricao ?? "Um sabor autêntico que você precisa provar.")</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="carrossel-slide">
                            <div class="slide-info" style="grid-column: 1 / -1; text-align: center;">
                                <h3>Novidades em breve!</h3>
                                <p>Estamos preparando os melhores pratos para você.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="carrossel-nav">
                <button class="carrossel-btn" onclick="moverCarrossel(-1)">❮</button>
                <div class="carrossel-dots" id="carrosselDots">
                    @if (Model != null && Model.Count > 0)
                    {
                        var totalExibir = Math.Min(Model.Count, 5);
                        for (int i = 0; i < totalExibir; i++)
                        {
                            <button class="carrossel-dot @(i == 0 ? "ativo" : "")" onclick="irParaSlide(@i)"></button>
                        }
                    }
                    else
                    {
                        <button class="carrossel-dot ativo" onclick="irParaSlide(0)"></button>
                    }
                </div>
                <button class="carrossel-btn" onclick="moverCarrossel(1)">❯</button>
            </div>
        </div>
    </div>

    <div class="secao">
        <div style="text-align: center; margin-bottom: 40px;">
            <span class="s-label">Por que escolher a gente</span>
            <span class="s-titulo">Nossos Diferenciais</span>
        </div>

        <div class="diferenciais-grid">
            <div class="dif-card">
                <h3>Cozinheiros Especializados</h3>
                <p>Nossa equipe é treinada nas técnicas da culinária mexicana tradicional para garantir autenticidade em cada prato.</p>
            </div>

            <div class="dif-card">
                <h3>Ingredientes Frescos</h3>
                <p>Selecionamos diariamente os melhores ingredientes. Guacamole feito na hora, temperos naturais, sem conservantes.</p>
            </div>

            <div class="dif-card">
                <h3>Ambiente Familiar</h3>
                <p>Espaço acolhedor para toda a família, com menu kids e atendimento que cuida de cada detalhe.</p>
            </div>

            <div class="dif-card">
                <h3>Eventos & Comemorações</h3>
                <p>Organizamos seu aniversário, confraternização ou evento corporativo com cardápio especial para grupos.</p>
            </div>
        </div>
    </div>


    <div class="faq-section">
        <div class="faq-inner">
            <span class="s-label" style="display:block; text-align:center;">Dúvidas frequentes</span>
            <span class="s-titulo" style="display:block; text-align:center; margin-bottom:8px;">Perguntas Frequentes</span>
            <p class="s-sub" style="text-align:center; margin: 0 auto 0;">Tudo o que você precisa saber antes de visitar a Fiesta Mexicana.</p>

            <div class="faq-lista">

                <div class="faq-item">
                    <button class="faq-pergunta" onclick="toggleFaq(this)">
                        Qual é o conceito da Fiesta Mexicana?
                        <span class="faq-icone">+</span>
                    </button>
                    <div class="faq-resposta">
                        A Fiesta Mexicana é um restaurante temático que traz a autêntica culinária mexicana de rua para São Paulo. Nossos pratos são preparados com ingredientes frescos e receitas tradicionais do centro e sudoeste do México — nada de Tex-Mex, só o México de verdade.
                    </div>
                </div>


                <div class="faq-item">
                    <button class="faq-pergunta" onclick="toggleFaq(this)">
                        O restaurante é adequado para crianças?
                        <span class="faq-icone">+</span>
                    </button>
                    <div class="faq-resposta">
                        Com certeza! Somos um ambiente familiar que acolhe crianças com carinho. Temos menu kids com opções mais suaves e sem pimenta, pensadas especialmente para os pequenos.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-pergunta" onclick="toggleFaq(this)">
                        Os pratos são muito apimentados?
                        <span class="faq-icone">+</span>
                    </button>
                    <div class="faq-resposta">
                        Nosso cardápio tem opções para todos os paladares. Cada prato indica o nível de picância e você pode pedir versões sem pimenta. O garçom também pode orientar sobre as melhores escolhas para quem não aprecia pimenta.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-pergunta" onclick="toggleFaq(this)">
                        Vocês fazem eventos e aniversários?
                        <span class="faq-icone">+</span>
                    </button>
                    <div class="faq-resposta">
                        Sim! Organizamos confraternizações, aniversários e eventos corporativos. Para grupos acima de 10 pessoas oferecemos condições especiais. Entre em contato para montar o pacote ideal para o seu evento.
                    </div>
                </div>


                <div class="faq-item">
                    <button class="faq-pergunta" onclick="toggleFaq(this)">
                        Qual o horário de funcionamento?
                        <span class="faq-icone">+</span>
                    </button>
                    <div class="faq-resposta">
                        Funcionamos de terça a sexta das 17h às 23h, sábados e feriados das 12h às 00h, e domingos das 12h às 17h. Confira horários especiais em datas comemorativas nas nossas redes sociais.
                    </div>
                </div>

            </div>
        </div>
    </div>


</div>

@section Scripts {
    <script>
        let slideAtual = 0;
        const totalSlides = @(Model != null ? Math.Min(Model.Count, 5) : 0);


        function atualizarCarrossel() {
            document.getElementById('carrosselTrack').style.transform = `translateX(-${slideAtual * 100}%)`;
            document.querySelectorAll('.carrossel-dot').forEach((d, i) => {
                d.classList.toggle('ativo', i === slideAtual);
            });
        }

        function moverCarrossel(dir) {
            slideAtual = (slideAtual + dir + totalSlides) % totalSlides;
            atualizarCarrossel();
        }

        function irParaSlide(i) {
            slideAtual = i;
            atualizarCarrossel();
        }

        function toggleFaq(btn) {
            const item = btn.closest('.faq-item');
            const aberto = item.classList.contains('aberto');
            document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('aberto'));
            if (!aberto) item.classList.add('aberto');
        }

        setInterval(() => moverCarrossel(1), 5500);
    </script>
}