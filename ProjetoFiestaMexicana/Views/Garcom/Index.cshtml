@model IEnumerable<ProjetoFiestaMexicana.Models.Garcom>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Garçons";
}

<div class="page-container">

    <h2>Garçons</h2>

    @if (TempData["ok"] != null)
    {
        <div class="ok">@TempData["ok"]</div>
    }
    @if (TempData["erro"] != null)
    {
        <div class="erro">@TempData["erro"]</div>
    }

    <p><a asp-action="Criar" class="btn-novo">Novo Garçom</a></p>

    <div class="table-responsive">
        <table class="tbl">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nome</th>
                    <th>Turno</th>
                    <th>Criado Em</th>
                    <th class="col-acoes">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td data-label="#">@g.Id</td>
                        <td data-label="Nome">@g.Nome</td>
                        <td data-label="Turno">@(string.IsNullOrWhiteSpace(g.Turno) ? "-" : g.Turno)</td>
                        <td data-label="Criado Em">@g.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-label="Ações">
                            <div class="acoes">
                                <form asp-action="Editar" method="get">
                                    <input type="hidden" name="id" value="@g.Id" />
                                    <button type="submit" class="btn btn-editar">Editar</button>
                                </form>
                                <form asp-action="Excluir" method="post" onsubmit="return confirm('Excluir este garçom?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@g.Id" />
                                    <button type="submit" class="btn btn-excluir">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>