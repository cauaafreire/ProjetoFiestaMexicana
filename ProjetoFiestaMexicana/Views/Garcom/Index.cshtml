@model IEnumerable<ProjetoFiestaMexicana.Models.Garcom>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Garçons";
}

<div class="page-container">

<h2>Garçons</h2>

@if (TempData["ok"] != null)
{
    <div class="ok">@TempData["ok"]</div>
}

<p><a asp-action="Criar" class="btn-novo">Novo Garçom</a></p>

<table class="tbl">
    <thead>
        <tr>
            <th>#</th>
            <th>Nome</th>
            <th>CPF</th>
            <th>Turno</th>
            <th>Criado Em</th>
            <th class="col-acoes">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <td>@g.Id</td>
                <td>@g.Nome</td>
                <td>@(string.IsNullOrWhiteSpace(g.Cpf) ? "-" : g.Cpf)</td>
                <td>@(string.IsNullOrWhiteSpace(g.Turno) ? "-" : g.Turno)</td>
                <td>@g.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <div class="acoes">
                        <form asp-action="Editar" method="get">
                            <input type="hidden" name="id" value="@g.Id" />
                            <button type="submit" class="btn btn-editar">Editar</button>
                        </form>
                        <form asp-action="Excluir" method="post" onsubmit="return confirm(\'Excluir este garçom?\');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@g.Id" />
                            <button type="submit" class="btn btn-excluir">Excluir</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
