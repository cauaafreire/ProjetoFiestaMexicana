@model ProjetoFiestaMexicana.Models.Garcom
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Editar Garçom";
}

<div class="page-header">
    <h2>Editar Garçom</h2>
</div>

<div class="card">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Editar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="form-grid">
            <div class="field">
                <label asp-for="Nome">Nome Completo</label>
                <input asp-for="Nome" class="input" required />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Cpf">CPF</label>
                <input asp-for="Cpf" class="input" maxlength="11" />
                <small class="hint">Apenas números, 11 dígitos.</small>
                <span asp-validation-for="Cpf" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Turno">Turno</label>
                <select asp-for="Turno" asp-items="ViewBag.Turnos" class="input">
                    <option value="">(Selecione o Turno)</option>
                </select>
                <span asp-validation-for="Turno" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn   btn btn-light">Salvar Alterações</button>
            <a asp-action="Index" class="btn btn-primary">Cancelar</a>
        </div>
    </form>
</div>

<style>
    /* Estilo Fiesta Mexicana - Editar Garçom */
    .page-header h2 {
        text-align: center;
        color: #2d2d2d;
        margin-top: 30px;
        font-family: 'Segoe UI', sans-serif;
    }

    .card {
        background: #ffffff;
        max-width: 600px;
        margin: 20px auto 50px auto;
        padding: 35px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        font-family: 'Segoe UI', sans-serif;
    }

    .form-grid {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .field label {
            font-weight: 600;
            color: #2d2d2d;
            font-size: 14px;
        }

    .input {
        padding: 12px 15px;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 15px;
        background-color: #fff;
        width: 100%;
        box-sizing: border-box;
        transition: border-color 0.3s;
    }

        .input:focus {
            border-color: #ff5a5f;
            outline: none;
        }

    /* Dica do CPF */
    .hint {
        color: #888;
        font-size: 12px;
        margin-top: -4px;
    }

    /* BOTÕES - Padrão Fiesta Mexicana */
    .form-actions {
        margin-top: 35px;
        display: flex;
        gap: 15px;
        justify-content: center;
    }

    .btn {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
        text-align: center;
        min-width: 150px;
        font-size: 15px;
        transition: all 0.2s;
        border: none;
    }

        /* Botão CANCELAR (Vermelho Fiesta) */
        .btn-light, .btn:not(.btn-primary) {
            background-color: #ff5a5f !important;
            color: #ffffff !important;
        }

    /* Botão SALVAR (Preto Fiesta) */
    .btn-primary {
        background-color: #2d2d2d !important;
        color: #ffffff !important;
    }

    .btn:hover {
        opacity: 0.85;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    /* Mensagens de Erro */
    .validation {
        background-color: #ffeaea;
        color: #ef4444;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        border: 1px solid #ef4444;
        font-size: 14px;
    }

    .text-danger {
        color: #ef4444;
        font-size: 13px;
    }
</style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
