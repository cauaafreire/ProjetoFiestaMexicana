@model ProjetoFiestaMexicana.Models.Usuarios
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-header h2 {
        text-align: center;
        color: #2d2d2d;
        margin-top: 30px;
        font-family: 'Segoe UI', sans-serif;
    }

    .card {
        background: #ffffff;
        max-width: 550px;
        margin: 20px auto 50px auto;
        padding: 35px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        font-family: 'Segoe UI', sans-serif;
    }

    .form-grid {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .field label {
            font-weight: 600;
            color: #2d2d2d;
            font-size: 14px;
        }

    .input {
        padding: 12px 15px;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 15px;
        background-color: #fff;
        width: 100%;
        box-sizing: border-box;
        transition: border-color 0.3s;
    }

        .input:focus {
            border-color: #ff5a5f;
            outline: none;
        }

        .input:disabled {
            background-color: #f9fafb;
            color: #9ca3af;
            cursor: not-allowed;
        }

    .form-actions {
        margin-top: 35px;
        display: flex;
        gap: 15px;
        justify-content: center;
    }

    .btn {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
        text-align: center;
        min-width: 150px;
        font-size: 15px;
        transition: all 0.2s;
        border: none;
    }

        .btn-light, .btn:not(.btn-primary) {
            background-color: #ff5a5f !important;
            color: #ffffff !important;
        }

    .btn-primary {
        background-color: #2d2d2d !important;
        color: #ffffff !important;
    }

    .btn:hover {
        opacity: 0.85;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .validation {
        background-color: #ffeaea;
        color: #ef4444;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        border: 1px solid #ef4444;
        font-size: 14px;
    }
</style>

<div class="page-header">
    <h2>Editar Usuário</h2>
</div>

<div class="card">
    @if (ViewBag.Erro != null)
    {
        <div class="validation">@ViewBag.Erro</div>
    }

    <form asp-action="Editar" asp-route-id="@Model.id" method="post">
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="field">
                <label>Nome</label>
                <input type="text" value="@Model.nome" class="input" disabled />
            </div>

            <div class="field">
                <label>E-mail</label>
                <input type="email" name="email" value="@Model.email" class="input" required />
            </div>

            <div class="field">
                <label>Cargo</label>
                <select asp-for="role" name="role" class="input" required>
                    <option value="Admin">Admin</option>
                    <option value="Chefe">Chefe</option>
                    <option value="Garcom">Garçom</option>
                </select>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-light">Salvar Alterações</button>
            <a asp-action="Index" class="btn btn-primary">Cancelar</a>
        </div>
    </form>
</div>