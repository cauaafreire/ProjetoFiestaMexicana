@model ProjetoFiestaMexicana.Models.Usuarios

<div class="card">
    <h2>🌮 Cadastrar Funcionário</h2>

    @if (ViewBag.Erro != null)
    {
        <div class="alert-danger">@ViewBag.Erro</div>
    }


    <form asp-action="CriarUsuario" method="post">
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="field">
                <label>Nome Completo</label>
                <input asp-for="nome" class="input" placeholder="Digite o nome" required />
            </div>

            <div class="field">
                <label>E-mail</label>
                <input asp-for="email" type="email" class="input" placeholder="exemplo@fiesta.com" required />
            </div>

            <div class="field">
                <label>Senha (Hash/Temporária)</label>
                <input asp-for="senha_hash" type="text" class="input" placeholder="Defina a senha" required />
            </div>

            <div class="field">
                <label>Cargo / Papel</label>
                <select name="role" class="input" required>
                    <option value="">Selecione o Cargo...</option>
                    <option value="Garcom">Garçom</option>
                    <option value="Chefe">Chefe de Cozinha</option>
                    <option value="Admin">Administrador</option>
                </select>
            </div>
        </div>

        <div class="form-actions">
            <a asp-controller="Home" asp-action="Index" class="btn">Voltar</a>
            <button type="submit" class="btn btn-primary">Salvar Funcionário</button>
        </div>
    </form>
</div>

<style>
    .card {
        background: #ffffff;
        max-width: 600px;
        margin: 40px auto;
        padding: 35px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        font-family: 'Segoe UI', sans-serif;
    }

        .card h2 {
            color: #2d2d2d;
            border-bottom: 3px solid #ff5a5f;
            padding-bottom: 12px;
            margin-bottom: 30px;
            font-size: 24px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .field label {
            font-weight: 600;
            color: #2d2d2d;
            font-size: 14px;
        }

    .input {
        padding: 12px 15px;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 15px;
        background-color: #fff;
        width: 100%;
        box-sizing: border-box;
    }

    .form-actions {
        margin-top: 35px;
        display: flex;
        gap: 15px;
        justify-content: center;
    }

    .btn {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
        text-align: center;
        min-width: 150px;
        font-size: 15px;
        transition: all 0.2s;
        border: none;
    }

        .btn:not(.btn-primary) {
            background-color: #ff5a5f !important;
            color: #ffffff !important;
        }

    .btn-primary {
        background-color: #2d2d2d !important;
        color: #ffffff !important;
    }

    .btn:hover {
        opacity: 0.85;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }
</style>
