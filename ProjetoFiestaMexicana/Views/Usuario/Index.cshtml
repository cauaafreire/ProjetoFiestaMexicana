@model IEnumerable<ProjetoFiestaMexicana.Models.Usuarios>
    
<link href="~/css/tables.css" rel="stylesheet" />

<div class="page-container">
        <h2> Gestão de Funcionários</h2>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert-success">@TempData["Sucesso"]</div>
    }

    <p>
        <a asp-action="CriarUsuario" class="btn-novo">+ Novo Funcionário</a>
    </p>

    <table class="tbl">
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Cargo</th>
                <th class="text-center">Ações</th>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.nome</td>
                    <td>@user.email</td>
                    <td><span class="badge">@user.role</span></td>
                    <td class="acoes">
                        <form asp-action="Excluir" asp-route-id="@user.id" method="post"
                              onsubmit="return confirm('Tem certeza que deseja remover este funcionário?')"
                              style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-excluir">Excluir</button>
                        </form>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
