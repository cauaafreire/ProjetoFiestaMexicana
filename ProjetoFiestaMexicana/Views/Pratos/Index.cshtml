@model IEnumerable<ProjetoFiestaMexicana.Models.Pratos>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cardápio - Pratos";
}

<h2>Pratos do Cardápio</h2>

@if (TempData["ok"] != null)
{
    <div class="ok">@TempData["ok"]</div>
}

<p><a asp-action="Criar">Novo Prato</a></p>

<style>
    .tbl { width: 100%; border-collapse: collapse; table-layout: auto; }
    .tbl th, .tbl td { padding: 8px 12px; border-bottom: 1px solid #e6e6e6; vertical-align: middle; text-align: left; }
    .tbl thead th { border-bottom: 2px solid #d0d0d0; font-weight: 600; background: #f8f8f8; }
    .tbl tbody tr:hover { background: #f1f1f1; }
    .acoes { display: flex; gap: 8px; justify-content: center; }
    .btn { padding: 5px 10px; border-radius: 4px; text-decoration: none; border: 1px solid #ccc; background: #fff; color: #333; cursor: pointer; }
    .btn-editar { border-color: #3b82f6; color: #3b82f6; }
    .btn-excluir { border-color: #ef4444; color: #ef4444; }
    .img-capa { width: 50px; height: 50px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd; }
</style>

<table class="tbl">
    <thead>
        <tr>
            <th>Capa</th>
            <th>Nome</th>
            <th>Preço</th>
            <th>Categoria</th>
            <th>Picância</th>
            <th>Disponível</th>
            <th class="col-acoes">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(p.CapaArquivo))
                    {
                        <img src="~/@p.CapaArquivo" class="img-capa" />
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td><strong>@p.Nome</strong></td>
                <td>@p.Preco.ToString("C")</td>
                <td>@(p.CategoriaNome ?? "-")</td>
                <td>@p.NivelPicancia</td>
                <td>@(p.Disponivel ? "✅ Sim" : "❌ Não")</td>
                <td class="col-acoes">
                    <div class="acoes">
                        <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-editar">Editar</a>
                        <form asp-action="Excluir" method="post" onsubmit="return confirm('Excluir este prato?');">
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="btn btn-excluir">Excluir</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
