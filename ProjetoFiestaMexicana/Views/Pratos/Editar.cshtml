@model ProjetoFiestaMexicana.Models.Pratos
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Editar Prato";
}

<div class="card">
    <h2>Editar Prato</h2>

    <form asp-action="Editar" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CapaArquivo" />

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="form-grid">
            <div class="field">
                <label>Nome do Prato</label>
                <input asp-for="Nome" class="input" required />
            </div>

            <div class="field">
                <label>Preço</label>
                <input asp-for="Preco" type="number" step="0.01" class="input" required />
            </div>

            <div class="field">
                <label>Descrição</label>
                <textarea asp-for="Descricao" class="input" rows="3"></textarea>
            </div>

            <div class="field">
                <label>Categoria</label>
                <select asp-for="CategoriaId" asp-items="ViewBag.ListaCategorias" class="input">
                    <option value="">(Selecione a Categoria)</option>
                </select>
            </div>

            <div class="field">
                <label>Método de Preparo</label>
                <select asp-for="MetodoPreparoId" asp-items="ViewBag.ListaMetodosPreparo" class="input">
                    <option value="">(Selecione o Método)</option>
                </select>
            </div>

            <div class="field">
                <label>Nível de Picância</label>
                <select asp-for="NivelPicancia" asp-items="ViewBag.ListaNiveisPicancia" class="input"></select>
            </div>

            <div class="field">
                <label>Tempo de Preparo (minutos)</label>
                <input asp-for="TempoPreparo" type="number" class="input" />
            </div>

            <div class="field">
                <label>
                    <input asp-for="Disponivel" type="checkbox" /> Disponível no Cardápio
                </label>
            </div>

            <div class="field">
                <label>Capa Atual</label>
                @if (!string.IsNullOrEmpty(Model.CapaArquivo))
                {
                    <img src="~/@Model.CapaArquivo" style="width: 100px; margin-bottom: 10px; border: 1px solid #ddd;" />
                }
                <input type="file" name="capa" accept="image/*" class="input" />
                <small>Deixe em branco para manter a capa atual.</small>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">Salvar Alterações</button>
            <a asp-action="Index" class="btn btn-primary">Cancelar</a>
        </div>
    </form>
</div>

<style>
    :root {
        --fiesta-red: #ff5a5f;
        --fiesta-dark: #2d2d2d;
    }

    /* Container do Card */
    .card {
        background: white;
        max-width: 650px; 
        margin: 40px auto;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .card h2 {
            color: var(--fiesta-dark);
            border-bottom: 2px solid var(--fiesta-red);
            padding-bottom: 10px;
            margin-bottom: 25px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .field:has(textarea),
    .field:has(input[type="checkbox"]),
    .field:has(input[type="file"]),
    .field:has(img) {
        grid-column: span 2;
    }

    .field {
        display: flex;
        flex-direction: column;
        margin-bottom: 10px;
    }

        .field label {
            font-weight: 600;
            margin-bottom: 5px;
            color: #555;
            font-size: 14px;
        }

    .input {
        padding: 10px 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 14px;
        transition: border-color 0.3s;
    }

        .input:focus {
            border-color: var(--fiesta-red);
            outline: none;
        }

    .field img {
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-top: 5px;
        object-fit: cover;
    }

    .field small {
        color: #888;
        margin-top: 5px;
        font-style: italic;
    }

    .form-actions {
        margin-top: 30px;
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .btn {
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
        transition: opacity 0.2s;
        text-align: center;
        min-width: 150px;
    }

        .btn:not(.btn-primary) {
            background-color: var(--fiesta-red);
            color: white !important;
        }

    .btn-primary {
        background-color: var(--fiesta-dark);
        color: white !important;
    }

    .btn:hover {
        opacity: 0.9;
    }

    .field label:has(input[type="checkbox"]) {
        flex-direction: row;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

    .validation {
        color: var(--fiesta-red);
        font-size: 13px;
        margin-bottom: 15px;
    }
</style>
